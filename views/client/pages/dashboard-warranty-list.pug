extends ../layouts/default.pug
include ../mixins/page-banner.pug

block main
  +page-banner(
    {
      name: pageTitle,
    },
    "/dashboard/warranty/list"
  )

  section.dashboard(class="mb_100")
    .container
      .row
        .col-xl-3.wow.fadeInUp
          include ../partials/dashboard-sidebar.pug
        .col-xl-9.wow.fadeInRight
          div(class="dashboard_content mt_100")
            .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2.mb-4
              h3(class="dashboard_title mb-0") #{pageTitle}
              a.btn.btn-outline-dark.rounded-pill(href="/tra-cuu-bao-hanh")
                i.fas.fa-magnifying-glass.me-1
                | Tra cứu bảo hành công khai

            // Khối 1: Danh sách thiết bị sở hữu (theo IMEI)
            .card.border-0.shadow-sm.rounded-4.mb-4
              .card-header.bg-light.py-3.px-4.border-bottom
                h5.mb-0.fw-bold.text-black
                  i.fas.fa-mobile-screen.me-2
                  | Thiết bị của bạn (#{devices.length})
              .card-body.p-0
                if (devices && devices.length > 0)
                  .table-responsive
                    table.table.table-hover.align-middle.mb-0
                      thead.table-light
                        tr
                          th.ps-4 Dòng máy & Phiên bản
                          th Mã IMEI
                          th Ngày mua
                          th Hạn BH
                          th Tình trạng
                          th.text-center.pe-4 Tra cứu
                      tbody
                        each dev in devices
                          tr
                            td.ps-4 #{dev.productName} #{dev.variantName ? `(${dev.variantName})` : ''}
                            td
                              code.fw-bold #{dev.identifier}
                            td #{dev.soldAt ? moment(dev.soldAt).format("DD/MM/YYYY") : '-'}
                            td #{dev.warrantyExpireDate ? moment(dev.warrantyExpireDate).format("DD/MM/YYYY") : '-'}
                            td
                              if dev.isUnderWarranty
                                span.badge.bg-success-subtle.text-success.fw-bold Còn bảo hành (#{dev.remainingDays} ngày)
                              else
                                span.badge.bg-secondary-subtle.text-secondary Hết bảo hành
                            td.text-center.pe-4
                              a.text-dark(href=`/tra-cuu-bao-hanh?keyword=${dev.identifier}`)
                                svg(
                                  width="24"
                                  height="24"
                                  stroke="currentColor" 
                                  stroke-width="1.5" 
                                  viewBox="0 0 24 24" 
                                  fill="none" 
                                  xmlns="http://www.w3.org/2000/svg"
                                )
                                  path(
                                    d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" 
                                    stroke-linejoin="round" 
                                    stroke-linecap="round"
                                  )
                                  path(
                                    d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" 
                                    stroke-linejoin="round" 
                                    stroke-linecap="round"
                                  )
                else
                  .p-4.text-center.text-muted
                    i.fas.fa-box-open.fs-2.mb-2.d-block
                    | Bạn chưa có thiết bị nào được lưu trên hệ thống hoặc chưa phát sinh đơn hàng có mã IMEI.

            // Khối 2: Lịch sử phiếu bảo hành / sửa chữa
            .card.border-0.shadow-sm.rounded-4
              .card-header.bg-light.py-3.px-4.border-bottom
                h5.mb-0.fw-bold.text-black
                  i.fas.fa-clock-rotate-left.me-2
                  | Lịch sử tiếp nhận bảo hành & sửa chữa (#{tickets.length})
              .card-body.p-0
                if (tickets && tickets.length > 0)
                  .table-responsive
                    table.table.table-hover.align-middle.mb-0
                      thead.table-light
                        tr
                          th.ps-4 Mã phiếu
                          th Thiết bị / IMEI
                          th Ngày nhận
                          th Lỗi tiếp nhận
                          th Trạng thái
                          th.text-end Chi phí
                          th.text-center.pe-4 Thao tác
                      tbody
                        each tk in tickets
                          tr
                            td.ps-4
                              a.text-primary(href=`/tra-cuu-bao-hanh?keyword=${tk.ticketCode}`) #{tk.ticketCode}
                              if tk.replacementIdentifier
                                span.badge.bg-success-subtle.text-success.d-block.mt-1 Đổi 1-1
                            td
                              .fw-semibold #{tk.productName}
                              code.small #{tk.identifier}
                            td #{moment(tk.createdAt).format("DD/MM/YYYY")}
                            td(style="max-width: 200px;")
                              .text-truncate(title=tk.issueDescription) #{tk.issueDescription}
                            td
                              case tk.status
                                when "received"
                                  span.badge.bg-secondary Mới nhận máy
                                when "inspecting"
                                  span.badge.bg-info.text-dark Đang sửa
                                when "waiting_parts"
                                  span.badge.bg-warning.text-dark Chờ linh kiện
                                when "completed"
                                  span.badge.bg-primary Đã xong
                                when "returned"
                                  span.badge.bg-success Đã nhận máy
                                when "cancelled"
                                  span.badge.bg-danger Đã hủy
                            td.text-end
                              if tk.totalAmount > 0
                                strong.text-danger #{Number(tk.totalAmount).toLocaleString('vi-VN')} đ
                              else
                                span.text-success.fw-semibold Miễn phí
                            td.text-center.pe-4
                              a.text-dark(href=`/tra-cuu-bao-hanh?keyword=${tk.ticketCode}`)
                                svg(
                                  width="24"
                                  height="24"
                                  stroke="currentColor" 
                                  stroke-width="1.5" 
                                  viewBox="0 0 24 24" 
                                  fill="none" 
                                  xmlns="http://www.w3.org/2000/svg"
                                )
                                  path(
                                    d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" 
                                    stroke-linejoin="round" 
                                    stroke-linecap="round"
                                  )
                                  path(
                                    d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" 
                                    stroke-linejoin="round" 
                                    stroke-linecap="round"
                                  )
                else
                  .p-4.text-center.text-muted
                    i.fas.fa-shield-heart.fs-2.mb-2.d-block.text-success
                    | Bạn chưa có yêu cầu bảo hành hoặc sửa chữa nào phát sinh.
