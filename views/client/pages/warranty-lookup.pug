extends ../layouts/default.pug

block main
  style.
    .warranty-lookup-wrapper {
      padding: 60px 0 90px;
      background: #f8fafc;
      min-height: 75vh;
    }
    .warranty-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
    }
    .search-input-pill {
      border: 2px solid #e2e8f0;
      border-radius: 50rem;
      padding: 6px 8px 6px 20px;
      background: #fff;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .search-input-pill:focus-within {
      border-color: #2563eb;
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
    }
    .search-input-pill input {
      border: none;
      box-shadow: none;
      font-size: 15px;
    }
    .search-input-pill input:focus {
      outline: none;
      box-shadow: none;
    }
    .stepper-container {
      position: relative;
      padding: 10px 0 20px;
    }
    .stepper-line-bg {
      position: absolute;
      top: 24px;
      left: 12%;
      right: 12%;
      height: 3px;
      background: #e2e8f0;
      z-index: 1;
    }
    .stepper-line-fill {
      height: 100%;
      background: #2563eb;
      transition: width 0.3s;
    }
    .stepper-col {
      position: relative;
      z-index: 2;
      text-align: center;
    }
    .stepper-dot {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #fff;
      border: 3px solid #cbd5e1;
      margin: 0 auto 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      color: #94a3b8;
      font-weight: 700;
    }
    .stepper-col.completed .stepper-dot {
      background: #2563eb;
      border-color: #2563eb;
      color: #fff;
    }
    .stepper-col.active .stepper-dot {
      background: #fff;
      border-color: #2563eb;
      color: #2563eb;
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);
    }
    .stepper-col .step-text {
      font-size: 13px;
      font-weight: 600;
      color: #64748b;
    }
    .stepper-col.completed .step-text,
    .stepper-col.active .step-text {
      color: #0f172a;
    }

  section.warranty-lookup-wrapper
    .container
      // Thanh tìm kiếm tinh gọn
      .row.justify-content-center.mb-4
        .col-xl-7.col-lg-8.col-md-10.text-center
          h3.fw-bold.mb-2 Tra cứu bảo hành & sửa chữa
          p.text-muted.small.mb-4 Nhập mã IMEI, mã phiếu (BH-...) hoặc số điện thoại mua hàng

          form#warrantyLookupForm(action="/tra-cuu-bao-hanh" method="GET")
            .search-input-pill.d-flex.align-items-center.shadow-sm
              i.fas.fa-search.text-muted.me-2
              input#warrantyKeywordInput.form-control(
                type="text"
                name="keyword"
                value=keyword
                placeholder="Nhập IMEI, Mã phiếu (BH-...) hoặc SĐT..."
                required
              )
              button.btn.btn-primary.rounded-pill.px-4.py-2.fw-semibold(type="submit")
                | Tra cứu

      // Khu vực kết quả
      if lookupResult
        .row.justify-content-center
          .col-xl-8.col-lg-9.col-md-11
            if (!lookupResult.found)
              .warranty-card.p-4.text-center
                i.fas.fa-circle-exclamation.text-warning.fs-1.mb-3
                h5.fw-bold.mb-1 Không tìm thấy kết quả
                p.text-muted.small.mb-3 #{lookupResult.message || `Không có dữ liệu cho từ khóa "${keyword}".`}
                a.btn.btn-outline-primary.btn-sm.rounded-pill(href="/tra-cuu-bao-hanh") Thử lại từ khóa khác

            // KẾT QUẢ THEO MÃ PHIẾU
            else if (lookupResult.mode === "ticket")
              - const t = lookupResult.ticket;
              .warranty-card.p-4.mb-3
                // Header gọn gàng
                .d-flex.justify-content-between.align-items-start.flex-wrap.gap-2.pb-3.border-bottom.mb-3
                  div
                    .small.text-muted Mã phiếu bảo hành
                    h4.fw-bold.text-primary.mb-0 #{t.ticketCode}
                  .text-end
                    case t.status
                      when "received"
                        span.badge.bg-secondary Mới tiếp nhận
                      when "inspecting"
                        span.badge.bg-info.text-dark Đang kiểm tra / sửa chữa
                      when "waiting_parts"
                        span.badge.bg-warning.text-dark Chờ linh kiện
                      when "completed"
                        span.badge.bg-success Đã xong (Chờ nhận máy)
                      when "returned"
                        span.badge.bg-primary Đã bàn giao khách
                      when "cancelled"
                        span.badge.bg-danger Đã hủy
                    if t.estimatedReturnDate
                      .small.text-muted.mt-1 Hẹn trả: #{moment(t.estimatedReturnDate).format("DD/MM/YYYY")}

                // Stepper tiến trình tối giản
                if t.status !== "cancelled"
                  .stepper-container.mb-3
                    .stepper-line-bg
                      - const pct = t.progressStep === 1 ? 0 : t.progressStep === 2 ? 33 : t.progressStep === 3 ? 66 : 100;
                      .stepper-line-fill(style=`width: ${pct}%`)
                    .row.g-0
                      .col-3.stepper-col(class=(t.progressStep > 1 ? "completed" : t.progressStep === 1 ? "active" : ""))
                        .stepper-dot 1
                        .step-text Tiếp nhận
                        .small.text-muted #{moment(t.createdAt).format("DD/MM")}
                      .col-3.stepper-col(class=(t.progressStep > 2 ? "completed" : t.progressStep === 2 ? "active" : ""))
                        .stepper-dot 2
                        .step-text Xử lý
                        .small.text-muted=(t.status === 'waiting_parts' ? 'Chờ linh kiện' : '')
                      .col-3.stepper-col(class=(t.progressStep > 3 ? "completed" : t.progressStep === 3 ? "active" : ""))
                        .stepper-dot 3
                        .step-text Hoàn tất
                        .small.text-muted=(t.estimatedReturnDate ? moment(t.estimatedReturnDate).format("DD/MM") : '')
                      .col-3.stepper-col(class=(t.progressStep >= 4 ? "completed" : ""))
                        .stepper-dot 4
                        .step-text Bàn giao
                        .small.text-muted=(t.returnedAt ? moment(t.returnedAt).format("DD/MM") : '')

                // Chi tiết thiết bị & lỗi
                .row.g-2.mb-3
                  .col-md-6
                    .p-3.bg-light.rounded-3.h-100
                      .small.text-muted Thiết bị
                      .fw-bold #{t.productName} #{t.variantName ? `(${t.variantName})` : ''}
                      .small.text-muted.mt-1 Mã IMEI: 
                        code.text-dark #{t.identifier}
                      if t.replacementIdentifier
                        .small.text-success.fw-bold.mt-1 Đổi 1-1 sang: #{t.replacementIdentifier}
                  .col-md-6
                    .p-3.bg-light.rounded-3.h-100
                      .small.text-muted Tình trạng lỗi tiếp nhận
                      .fw-semibold #{t.issueDescription}
                      if t.resolutionNote
                        .small.text-success.mt-1.pt-1.border-top
                          strong Kết quả: 
                          | #{t.resolutionNote}

                // Chi phí & Linh kiện (chỉ hiện nếu có)
                if (t.partsUsed && t.partsUsed.length > 0)
                  .border.rounded-3.p-3.mb-3
                    .small.fw-bold.text-muted.mb-2 Linh kiện thay thế:
                    each part in t.partsUsed
                      .d-flex.justify-content-between.small.py-1.border-bottom
                        span #{part.partName} × #{part.quantity}
                        span.fw-semibold #{(part.quantity * part.unitPrice).toLocaleString('vi-VN')} đ

                .d-flex.justify-content-between.align-items-center.p-3.bg-light.rounded-3
                  span.fw-bold Tổng thanh toán:
                  if t.totalAmount > 0
                    h5.fw-bold.text-danger.mb-0 #{Number(t.totalAmount).toLocaleString('vi-VN')} đ
                  else
                    span.badge.bg-success Miễn phí (Bảo hành chính hãng)

            // KẾT QUẢ THEO MÃ IMEI
            else if (lookupResult.mode === "imei")
              - const dev = lookupResult.device;
              .warranty-card.p-4.mb-3
                .d-flex.justify-content-between.align-items-start.flex-wrap.gap-2.pb-3.border-bottom.mb-3
                  div
                    .small.text-muted Thiết bị
                    h4.fw-bold.mb-0 #{dev.productName} #{dev.variantName ? `(${dev.variantName})` : ''}
                    .small.text-muted.mt-1 IMEI: 
                      code.text-dark.fw-bold #{dev.identifier}
                  div.text-end
                    if dev.isUnderWarranty
                      span.badge.bg-success.fs-6 Còn bảo hành (#{dev.remainingDays} ngày)
                    else
                      span.badge.bg-secondary.fs-6 Hết hạn bảo hành

                .row.g-2.text-center.mb-3
                  .col-6
                    .p-2.bg-light.rounded-3
                      .small.text-muted Ngày mua / Kích hoạt
                      strong #{dev.soldAt ? moment(dev.soldAt).format("DD/MM/YYYY") : 'Chưa có thông tin'}
                  .col-6
                    .p-2.bg-light.rounded-3
                      .small.text-muted Hạn bảo hành (#{dev.warrantyMonths} tháng)
                      strong(class=(dev.isUnderWarranty ? "text-success" : "text-danger"))
                        | #{dev.warrantyExpireDate ? moment(dev.warrantyExpireDate).format("DD/MM/YYYY") : '-'}

                // Lịch sử bảo hành gọn nhẹ
                if (lookupResult.tickets && lookupResult.tickets.length > 0)
                  .small.fw-bold.text-muted.mb-2 Lịch sử bảo hành máy (#{lookupResult.tickets.length}):
                  .table-responsive
                    table.table.table-sm.table-bordered.align-middle.mb-0
                      thead.table-light
                        tr
                          th Mã phiếu
                          th Ngày nhận
                          th Lỗi
                          th Trạng thái
                      tbody
                        each tk in lookupResult.tickets
                          tr
                            td
                              a.fw-bold(href=`/tra-cuu-bao-hanh?keyword=${tk.ticketCode}`) #{tk.ticketCode}
                            td #{moment(tk.createdAt).format("DD/MM/YYYY")}
                            td #{tk.issueDescription}
                            td #{tk.status}
                else
                  .small.text-muted.text-center.py-2 Chưa có lần bảo hành nào trước đây.

            // KẾT QUẢ THEO SỐ ĐIỆN THOẠI
            else if (lookupResult.mode === "phone")
              .warranty-card.p-4.mb-3
                .pb-3.border-bottom.mb-3
                  .small.text-muted Lịch sử thiết bị theo SĐT
                  h5.fw-bold.mb-0 #{lookupResult.customerName} — #{lookupResult.maskedPhone}

                if (lookupResult.devices && lookupResult.devices.length > 0)
                  .small.fw-bold.text-muted.mb-2 Thiết bị đã mua (#{lookupResult.devices.length}):
                  .table-responsive.mb-3
                    table.table.table-sm.table-bordered.align-middle
                      thead.table-light
                        tr
                          th Tên máy
                          th Mã IMEI
                          th Hạn bảo hành
                          th.text-center Tra cứu
                      tbody
                        each d in lookupResult.devices
                          tr
                            td.fw-semibold #{d.productName} #{d.variantName ? `(${d.variantName})` : ''}
                            td
                              code #{d.identifier}
                            td
                              if d.isUnderWarranty
                                span.badge.bg-success Còn BH (#{d.remainingDays} ngày)
                              else
                                span.badge.bg-secondary Hết BH
                            td.text-center
                              a.btn.btn-sm.btn-outline-primary.py-0.px-2(href=`/tra-cuu-bao-hanh?keyword=${d.identifier}`) Xem

                if (lookupResult.tickets && lookupResult.tickets.length > 0)
                  .small.fw-bold.text-muted.mb-2 Lịch sử phiếu bảo hành (#{lookupResult.tickets.length}):
                  .table-responsive
                    table.table.table-sm.table-bordered.align-middle.mb-0
                      thead.table-light
                        tr
                          th Mã phiếu
                          th Máy / IMEI
                          th Ngày nhận
                          th Trạng thái
                          th.text-center Chi tiết
                      tbody
                        each tk in lookupResult.tickets
                          tr
                            td.fw-bold #{tk.ticketCode}
                            td #{tk.productName}
                            td #{moment(tk.createdAt).format("DD/MM/YYYY")}
                            td #{tk.status}
                            td.text-center
                              a.btn.btn-sm.btn-outline-primary.py-0.px-2(href=`/tra-cuu-bao-hanh?keyword=${tk.ticketCode}`) Xem

            // Hỗ trợ nhanh 1 dòng gọn gàng
            .text-center.mt-3
              small.text-muted
                | Cần hỗ trợ thêm? Gọi ngay 
                a.fw-bold.text-decoration-none(href="tel:0982887766") 0982.887.766
                |  (Miễn phí)
