extends ../layouts/default.pug
include ../mixins/page-banner.pug

block main
  +page-banner(
    {
      name: "Tra cứu Bảo hành & Sửa chữa",
    },
    "/tra-cuu-bao-hanh"
  )

  section.warranty_lookup_area(class="pt_60 pb_100")
    .container
      // Thanh tìm kiếm chính
      .row.justify-content-center.mb-5
        .col-xl-8.col-lg-10
          .card.shadow-sm.border-0.rounded-4.overflow-hidden
            .card-body.p-4.p-md-5.text-center(style="background: linear-gradient(135deg, #f8f9fa 0%, #eef2f7 100%);")
              span.badge.bg-primary-subtle.text-primary.px-3.py-2.rounded-pill.fw-semibold.mb-3
                i.fas.fa-shield-alt.me-1
                | Hệ Thống Tra Cứu Bảo Hành & Sửa Chữa Chính Hãng
              h2.fw-bold.mb-3 Kiểm Tra Tiến Độ & Hạn Bảo Hành
              p.text-muted.mb-4
                | Quý khách vui lòng nhập 
                strong Mã IMEI
                | , 
                strong Mã phiếu (BH-...)
                |  hoặc 
                strong Số điện thoại mua hàng
                |  để tra cứu nhanh thông tin.

              form#warrantyLookupForm(action="/tra-cuu-bao-hanh" method="GET")
                .input-group.input-group-lg.shadow-sm.rounded-pill.overflow-hidden.bg-white.p-1.border
                  span.input-group-text.bg-transparent.border-0.ps-3.text-muted
                    i.fas.fa-search.fs-5
                  input#warrantyKeywordInput.form-control.border-0.shadow-none.px-2(
                    type="text"
                    name="keyword"
                    value=keyword
                    placeholder="Ví dụ: 356890123456781 hoặc BH-20261108-12345 hoặc 0982887761"
                    required
                    autocomplete="off"
                  )
                  button.btn.btn-primary.px-4.py-2.rounded-pill.fw-semibold(type="submit")
                    i.fas.fa-magnifying-glass.me-1
                    | Tra cứu ngay

              .row.g-3.mt-3.text-start
                .col-md-4
                  .p-2.bg-white.rounded-3.border.small
                    strong.text-primary
                      i.fas.fa-barcode.me-1
                      | Mã IMEI
                    .text-muted.mt-1 Kiểm tra hạn bảo hành, ngày kích hoạt máy.
                .col-md-4
                  .p-2.bg-white.rounded-3.border.small
                    strong.text-success
                      i.fas.fa-file-invoice.me-1
                      | Mã phiếu (BH-...)
                    .text-muted.mt-1 Theo dõi tiến độ sửa chữa, thay linh kiện.
                .col-md-4
                  .p-2.bg-white.rounded-3.border.small
                    strong.text-warning
                      i.fas.fa-phone.me-1
                      | Số điện thoại
                    .text-muted.mt-1 Xem toàn bộ máy & phiếu sửa theo SĐT.

      // Khu vực hiển thị kết quả tra cứu
      if lookupResult
        .row.justify-content-center
          .col-xl-9.col-lg-11
            if (!lookupResult.found)
              .card.border-0.shadow-sm.rounded-4.text-center.p-5
                .mb-3
                  i.fas.fa-circle-exclamation.text-warning(style="font-size: 64px;")
                h4.fw-bold.text-danger.mb-2 Không tìm thấy dữ liệu!
                p.text-muted.mb-4 #{lookupResult.message || `Không tìm thấy thông tin phù hợp với từ khóa "${keyword}".`}
                .d-flex.justify-content-center.gap-2
                  a.btn.btn-outline-primary.rounded-pill(href="/tra-cuu-bao-hanh")
                    i.fas.fa-rotate-left.me-1
                    | Thử lại từ khóa khác
                  a.btn.btn-success.rounded-pill(href="tel:0982887766")
                    i.fas.fa-headset.me-1
                    | Gọi Hotline hỗ trợ: 0982.887.766

            else if (lookupResult.mode === "ticket")
              - const t = lookupResult.ticket;
              .card.border-0.shadow-sm.rounded-4.mb-4.overflow-hidden
                .card-header.bg-primary.text-white.p-4.d-flex.justify-content-between.align-items-center.flex-wrap.gap-2
                  div
                    span.badge.bg-white.text-primary.fw-bold.mb-1
                      case t.warrantyType
                        when "warranty"
                          | Phiếu Bảo Hành Tiêu Chuẩn
                        when "repair"
                          | Phiếu Sửa Chữa Dịch Vụ
                        when "exchange"
                          | Phiếu Đổi Mới 1-1
                    h3.card-title.text-white.mb-0 Mã phiếu: #{t.ticketCode}
                  .text-end
                    case t.status
                      when "received"
                        span.badge.bg-secondary.fs-6 Mới tiếp nhận máy
                      when "inspecting"
                        span.badge.bg-info.text-dark.fs-6 Đang kiểm tra / sửa chữa
                      when "waiting_parts"
                        span.badge.bg-warning.text-dark.fs-6 Đang chờ linh kiện
                      when "completed"
                        span.badge.bg-success.fs-6 Đã xong - Mời quý khách đến nhận
                      when "returned"
                        span.badge.bg-light.text-dark.fs-6 Đã bàn giao trả khách
                      when "cancelled"
                        span.badge.bg-danger.fs-6 Đã hủy phiếu

                .card-body.p-4
                  // Thanh tiến trình Stepper 4 bước
                  if (t.status !== "cancelled")
                    .mb-5.pt-2
                      h5.fw-bold.mb-3
                        i.fas.fa-clock-rotate-left.me-2.text-primary
                        | Tiến trình xử lý phiếu
                      .row.text-center.position-relative
                        .col-3
                          .p-2.rounded-3(class=(t.progressStep >= 1 ? "bg-primary text-white" : "bg-light text-muted"))
                            i.fas.fa-clipboard-check.fs-4.mb-1
                            .fw-semibold.small 1. Tiếp nhận
                          small.text-muted.d-block.mt-1 #{moment(t.createdAt).format("DD/MM/YYYY")}
                        .col-3
                          .p-2.rounded-3(class=(t.progressStep >= 2 ? "bg-primary text-white" : "bg-light text-muted"))
                            i.fas.fa-screwdriver-wrench.fs-4.mb-1
                            .fw-semibold.small 2. Đang xử lý
                          small.text-muted.d-block.mt-1
                            if (t.status === "waiting_parts")
                              span.text-warning Chờ linh kiện
                            else if (t.progressStep >= 2)
                              span.text-success Đang kỹ thuật
                            else
                              | Đang chờ
                        .col-3
                          .p-2.rounded-3(class=(t.progressStep >= 3 ? "bg-primary text-white" : "bg-light text-muted"))
                            i.fas.fa-circle-check.fs-4.mb-1
                            .fw-semibold.small 3. Hoàn tất
                          small.text-muted.d-block.mt-1
                            if (t.estimatedReturnDate)
                              | Hẹn trả: #{moment(t.estimatedReturnDate).format("DD/MM")}
                        .col-3
                          .p-2.rounded-3(class=(t.progressStep >= 4 ? "bg-success text-white" : "bg-light text-muted"))
                            i.fas.fa-handshake.fs-4.mb-1
                            .fw-semibold.small 4. Đã bàn giao
                          small.text-muted.d-block.mt-1
                            if (t.returnedAt)
                              | #{moment(t.returnedAt).format("DD/MM/YYYY")}

                  // Thông tin thiết bị & Khách hàng
                  .row.g-3.mb-4
                    .col-md-6
                      .p-3.bg-light.rounded-3.border.h-100
                        h6.fw-bold.text-primary.mb-2
                          i.fas.fa-mobile-screen.me-2
                          | Thiết bị tiếp nhận
                        .mb-1
                          span.text-muted Dòng máy: 
                          strong #{t.productName} #{t.variantName ? `(${t.variantName})` : ''}
                        .mb-1
                          span.text-muted Mã IMEI: 
                          code.fw-bold.fs-6 #{t.identifier}
                        if t.replacementIdentifier
                          .mt-2.p-2.bg-success-subtle.border.border-success.rounded
                            strong.text-success
                              i.fas.fa-rotate.me-1
                              | Đã đổi mới sang IMEI: #{t.replacementIdentifier}
                        .mb-1
                          span.text-muted Tình trạng khi nhận: 
                          span #{t.deviceCondition || 'Bình thường'}
                        .mb-0
                          span.text-muted Phụ kiện kèm theo: 
                          span #{t.accessoriesIncluded || 'Chỉ thân máy'}

                    .col-md-6
                      .p-3.bg-light.rounded-3.border.h-100
                        h6.fw-bold.text-primary.mb-2
                          i.fas.fa-user.me-2
                          | Khách hàng & Ngày hẹn
                        .mb-1
                          span.text-muted Người gửi máy: 
                          strong #{t.customerName}
                        .mb-1
                          span.text-muted Số điện thoại: 
                          strong #{t.customerPhone}
                        .mb-1
                          span.text-muted Ngày tiếp nhận: 
                          span #{moment(t.createdAt).format("DD/MM/YYYY HH:mm")}
                        if t.estimatedReturnDate
                          .mb-1
                            span.text-muted Ngày hẹn dự kiến: 
                            strong.text-primary #{moment(t.estimatedReturnDate).format("DD/MM/YYYY")}
                        if t.returnedAt
                          .mb-0
                            span.text-muted Đã trả máy lúc: 
                            strong.text-success #{moment(t.returnedAt).format("DD/MM/YYYY HH:mm")}

                  .p-3.border.rounded-3.mb-4
                    label.fw-bold.text-muted.small.d-block.mb-1
                      i.fas.fa-triangle-exclamation.me-1.text-warning
                      | Mô tả lỗi của máy khi khách mang đến:
                    .fw-semibold #{t.issueDescription}
                    if t.resolutionNote
                      .mt-2.pt-2.border-top
                        label.fw-bold.text-muted.small.d-block.mb-1
                          i.fas.fa-tools.me-1.text-info
                          | Kết quả kiểm tra & Xử lý kỹ thuật:
                        .text-success.fw-semibold #{t.resolutionNote}

                  // Linh kiện thay thế & Chi phí
                  if (t.partsUsed && t.partsUsed.length > 0)
                    .mb-3
                      h6.fw-bold.mb-2
                        i.fas.fa-microchip.me-2.text-primary
                        | Linh kiện thay thế
                      .table-responsive
                        table.table.table-sm.table-bordered.align-middle.mb-2
                          thead.table-light
                            tr
                              th STT
                              th Tên linh kiện
                              th.text-center Số lượng
                              th.text-end Đơn giá
                              th.text-end Thành tiền
                          tbody
                            each part, idx in t.partsUsed
                              tr
                                td.text-center #{idx + 1}
                                td.fw-semibold #{part.partName}
                                td.text-center #{part.quantity}
                                td.text-end #{Number(part.unitPrice || 0).toLocaleString('vi-VN')} đ
                                td.text-end.fw-semibold #{(Number(part.quantity || 1) * Number(part.unitPrice || 0)).toLocaleString('vi-VN')} đ

                  .d-flex.justify-content-between.align-items-center.p-3.bg-light.rounded-3.border
                    span.fw-bold.fs-6 Tổng chi phí sửa chữa / bảo hành:
                    if t.totalAmount > 0
                      h4.text-danger.fw-bold.mb-0 #{Number(t.totalAmount).toLocaleString('vi-VN')} đ
                    else
                      span.badge.bg-success.fs-6 Miễn phí (Bảo hành chính hãng)

            else if (lookupResult.mode === "imei")
              - const dev = lookupResult.device;
              .card.border-0.shadow-sm.rounded-4.mb-4.overflow-hidden
                .card-header.bg-primary.text-white.p-4.d-flex.justify-content-between.align-items-center.flex-wrap.gap-2
                  div
                    span.badge.bg-white.text-primary.fw-bold.mb-1 Thông Tin Bảo Hành Thiết Bị
                    h3.card-title.text-white.mb-0 #{dev.productName} #{dev.variantName ? `(${dev.variantName})` : ''}
                  div
                    if (dev.isUnderWarranty)
                      span.badge.bg-success.fs-6
                        i.fas.fa-check-circle.me-1
                        | CÒN BẢO HÀNH (Còn #{dev.remainingDays} ngày)
                    else
                      span.badge.bg-secondary.fs-6
                        i.fas.fa-circle-xmark.me-1
                        | HẾT HẠN BẢO HÀNH

                .card-body.p-4
                  .row.g-3.mb-4
                    .col-md-4
                      .p-3.bg-light.rounded-3.border.text-center
                        .text-muted.small.mb-1 Mã IMEI thiết bị
                        code.fs-5.fw-bold.text-dark #{dev.identifier}
                    .col-md-4
                      .p-3.bg-light.rounded-3.border.text-center
                        .text-muted.small.mb-1 Ngày mua / Kích hoạt
                        strong.fs-6.text-primary #{dev.soldAt ? moment(dev.soldAt).format("DD/MM/YYYY") : 'Chưa có thông tin'}
                    .col-md-4
                      .p-3.bg-light.rounded-3.border.text-center
                        .text-muted.small.mb-1 Hạn bảo hành (#{dev.warrantyMonths} tháng)
                        strong.fs-6(class=(dev.isUnderWarranty ? "text-success" : "text-danger"))
                          | #{dev.warrantyExpireDate ? moment(dev.warrantyExpireDate).format("DD/MM/YYYY") : 'Không áp dụng'}

                  // Lịch sử các lần bảo hành / sửa chữa của IMEI này
                  h5.fw-bold.mb-3
                    i.fas.fa-history.me-2.text-primary
                    | Lịch sử tiếp nhận bảo hành & sửa chữa của máy (#{lookupResult.tickets.length})
                  if (lookupResult.tickets && lookupResult.tickets.length > 0)
                    .table-responsive
                      table.table.table-bordered.align-middle.mb-0
                        thead.table-light
                          tr
                            th Mã phiếu
                            th Ngày tiếp nhận
                            th Mô tả lỗi
                            th Kết quả xử lý
                            th Trạng thái
                        tbody
                          each tk in lookupResult.tickets
                            tr
                              td
                                a.fw-bold.text-primary(href=`/tra-cuu-bao-hanh?keyword=${tk.ticketCode}`) #{tk.ticketCode}
                              td #{moment(tk.createdAt).format("DD/MM/YYYY")}
                              td #{tk.issueDescription}
                              td #{tk.resolutionNote || 'Đang xử lý'}
                              td
                                case tk.status
                                  when "received"
                                    span.badge.bg-secondary Mới nhận
                                  when "inspecting"
                                    span.badge.bg-info.text-dark Đang sửa
                                  when "waiting_parts"
                                    span.badge.bg-warning.text-dark Chờ linh kiện
                                  when "completed"
                                    span.badge.bg-primary Đã xong
                                  when "returned"
                                    span.badge.bg-success Đã bàn giao
                                  when "cancelled"
                                    span.badge.bg-danger Đã hủy
                  else
                    .alert.alert-light.border.text-center.py-4
                      i.fas.fa-shield-heart.text-success.fs-3.mb-2.d-block
                      | Thiết bị này chưa từng có lịch sử bảo hành hoặc sửa chữa nào tại hệ thống.

            else if (lookupResult.mode === "phone")
              .card.border-0.shadow-sm.rounded-4.mb-4.overflow-hidden
                .card-header.bg-primary.text-white.p-4
                  h3.card-title.text-white.mb-1 Lịch Sử Mua Hàng & Bảo Hành
                  p.mb-0 Khách hàng: <strong>#{lookupResult.customerName}</strong> | Số điện thoại: <strong>#{lookupResult.maskedPhone}</strong>

                .card-body.p-4
                  // Khối Thiết bị đã mua
                  h5.fw-bold.mb-3
                    i.fas.fa-mobile-screen-button.me-2.text-primary
                    | Danh sách thiết bị đã mua (#{lookupResult.devices.length})
                  if (lookupResult.devices && lookupResult.devices.length > 0)
                    .table-responsive.mb-4
                      table.table.table-bordered.align-middle
                        thead.table-light
                          tr
                            th Tên thiết bị
                            th Mã IMEI
                            th Ngày mua
                            th Hạn bảo hành
                            th Trạng thái
                            th.text-center Thao tác
                        tbody
                          each d in lookupResult.devices
                            tr
                              td.fw-semibold #{d.productName} #{d.variantName ? `(${d.variantName})` : ''}
                              td
                                code #{d.identifier}
                              td #{d.soldAt ? moment(d.soldAt).format("DD/MM/YYYY") : '-'}
                              td #{d.warrantyExpireDate ? moment(d.warrantyExpireDate).format("DD/MM/YYYY") : '-'}
                              td
                                if d.isUnderWarranty
                                  span.badge.bg-success Còn bảo hành (#{d.remainingDays} ngày)
                                else
                                  span.badge.bg-secondary Hết bảo hành
                              td.text-center
                                a.btn.btn-sm.btn-outline-primary.rounded-pill(href=`/tra-cuu-bao-hanh?keyword=${d.identifier}`)
                                  i.fas.fa-magnifying-glass.me-1
                                  | Tra cứu máy
                  else
                    .alert.alert-light.border.mb-4 Chưa có thiết bị IMEI nào gắn với số điện thoại này.

                  // Khối Phiếu bảo hành
                  h5.fw-bold.mb-3
                    i.fas.fa-clipboard-list.me-2.text-primary
                    | Danh sách phiếu bảo hành / sửa chữa (#{lookupResult.tickets.length})
                  if (lookupResult.tickets && lookupResult.tickets.length > 0)
                    .table-responsive
                      table.table.table-bordered.align-middle.mb-0
                        thead.table-light
                          tr
                            th Mã phiếu
                            th Thiết bị / IMEI
                            th Ngày nhận
                            th Tình trạng lỗi
                            th Trạng thái
                            th.text-center Thao tác
                        tbody
                          each tk in lookupResult.tickets
                            tr
                              td.fw-bold #{tk.ticketCode}
                              td
                                div #{tk.productName}
                                code.small #{tk.identifier}
                              td #{moment(tk.createdAt).format("DD/MM/YYYY")}
                              td #{tk.issueDescription}
                              td
                                case tk.status
                                  when "received"
                                    span.badge.bg-secondary Mới tiếp nhận
                                  when "inspecting"
                                    span.badge.bg-info.text-dark Đang sửa
                                  when "waiting_parts"
                                    span.badge.bg-warning.text-dark Chờ linh kiện
                                  when "completed"
                                    span.badge.bg-primary Đã xong
                                  when "returned"
                                    span.badge.bg-success Đã nhận máy
                                  when "cancelled"
                                    span.badge.bg-danger Đã hủy
                              td.text-center
                                a.btn.btn-sm.btn-outline-primary.rounded-pill(href=`/tra-cuu-bao-hanh?keyword=${tk.ticketCode}`)
                                  | Xem chi tiết
                  else
                    .alert.alert-light.border Chưa có phiếu bảo hành hoặc sửa chữa nào cho số điện thoại này.

  // Khối tư vấn hỗ trợ
  section.warranty_support_area(class="pb_100")
    .container
      .row.justify-content-center
        .col-xl-9.col-lg-11
          .p-4.p-md-5.bg-white.rounded-4.border.shadow-sm
            .row.align-items-center
              .col-md-8
                h4.fw-bold.mb-2 Bạn Cần Trợ Giúp Về Bảo Hành & Kỹ Thuật?
                p.text-muted.mb-md-0
                  | Tổng đài chăm sóc khách hàng và tiếp nhận sửa chữa sẵn sàng giải đáp mọi thắc mắc từ 8:00 - 21:00 hàng ngày.
              .col-md-4.text-md-end
                a.btn.btn-success.btn-lg.px-4.rounded-pill.shadow-sm(href="tel:0982887766")
                  i.fas.fa-phone-volume.me-2
                  | 0982.887.766
