extends ../layouts/default.pug

block main
  style.
    .wholesale-reg-page {
      padding: 50px 0 80px;
      background: #f8fafc;
      min-height: 75vh;
    }
    .reg-form-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 20px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.04);
      max-width: 720px;
      margin: 0 auto;
    }

  section.wholesale-reg-page
    .container
      if (accountUser && accountUser.isWholesale)
        // Trường hợp tài khoản đã được duyệt đại lý
        .reg-form-card.p-5.text-center
          .mb-3
            i.fas.fa-check-circle.text-success(style="font-size: 56px;")
          h4.fw-bold.text-dark Bạn đang là Đại lý chính thức!
          p.text-muted.mb-4 Tài khoản của bạn đã được áp dụng bảng giá sỉ trên toàn hệ thống.
          if accountUser.storeName
            .p-3.bg-light.rounded-3.d-inline-block.text-start.mb-4(style="max-width: 420px; width: 100%;")
              .small.text-muted Cửa hàng:
              .fw-bold.text-dark #{accountUser.storeName}
              if accountUser.businessAddress
                .small.text-muted.mt-1 Địa chỉ:
                .text-dark.small #{accountUser.businessAddress}
          div
            a.btn.btn-primary.px-4.py-2.rounded-pill(href="/product/category")
              i.fas.fa-shopping-cart.me-1
              | Khám phá giá sỉ & Mua sắm
            a.btn.btn-outline-secondary.px-4.py-2.rounded-pill.ms-2(href="/dashboard")
              | Quản lý tài khoản
      else
        // Form đăng ký tinh giản, tập trung vào form
        .reg-form-card.p-4.p-md-5
          .text-center.mb-4
            h3.fw-bold.text-dark Đăng Ký Đại Lý / Khách Sỉ

          form#wholesaleRegisterForm(action="/dang-ky-dai-ly" method="POST")
            .row.g-3
              .col-md-6
                label.form-label.fw-semibold.small(for="fullName") Họ và tên người đại diện *
                input#fullName.form-control(
                  type="text"
                  name="fullName"
                  value=(accountUser ? accountUser.fullName : "")
                  required
                )
              .col-md-6
                label.form-label.fw-semibold.small(for="phone") Số điện thoại *
                input#phone.form-control(
                  type="text"
                  name="phone"
                  value=(accountUser ? accountUser.phone : "")
                  required
                )
              .col-md-6
                label.form-label.fw-semibold.small(for="email") Email đăng nhập *
                input#email.form-control(
                  type="email"
                  name="email"
                  value=(accountUser ? accountUser.email : "")
                  required=(!accountUser)
                )
              .col-md-6
                label.form-label.fw-semibold.small(for="storeName") Tên Cửa hàng *
                input#storeName.form-control(
                  type="text"
                  name="storeName"
                  required
                )
              .col-12
                label.form-label.fw-semibold.small(for="businessAddress") Địa chỉ Cửa hàng *
                input#businessAddress.form-control(
                  type="text"
                  name="businessAddress"
                  required
                )
              if (!accountUser)
                .col-md-6
                  label.form-label.fw-semibold.small(for="password") Mật khẩu đăng nhập *
                  input#password.form-control(
                    type="password"
                    name="password"
                    placeholder="Tối thiểu 6 ký tự"
                    minlength="6"
                    required
                  )
                .col-md-6
                  label.form-label.fw-semibold.small(for="confirmPassword") Xác nhận mật khẩu *
                  input#confirmPassword.form-control(
                    type="password"
                    name="confirmPassword"
                    placeholder="Nhập lại mật khẩu"
                    minlength="6"
                    required
                  )
              .col-md-6
                label.form-label.fw-semibold.small(for="taxCode") Mã số thuế (MST)
                input#taxCode.form-control(
                  type="text"
                  name="taxCode"
                )
              .col-md-6
                label.form-label.fw-semibold.small(for="note") Ghi chú
                input#note.form-control(
                  type="text"
                  name="note"
                )

            .mt-4.pt-2.d-flex.align-items-center.justify-content-between.flex-wrap.gap-2
              button#submitBtn.btn.btn-primary.px-4.py-2.rounded-pill(type="submit")
                i.fas.fa-paper-plane.me-1
                | Gửi thông tin đăng ký
              if (!accountUser)
                small.text-muted
                  | Đã có tài khoản? 
                  a.text-primary.text-decoration-none.fw-semibold(href="/auth/login") Đăng nhập

  script.
    window.addEventListener("DOMContentLoaded", function () {
      var toastInstance = null;
      function showToast(type, msg) {
        try {
          if (!toastInstance && typeof Notyf !== "undefined") {
            toastInstance = new Notyf({ duration: 3500, position: { x: "right", y: "top" } });
          }
          if (toastInstance && toastInstance[type]) {
            toastInstance[type](msg);
            return;
          }
        } catch (e) {}
        alert(msg);
      }

      var regForm = document.getElementById("wholesaleRegisterForm");
      if (regForm) {
        regForm.addEventListener("submit", async function (e) {
          e.preventDefault();
          var btn = document.getElementById("submitBtn");
          var originalText = btn.innerHTML;
          btn.disabled = true;
          btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang gửi...';

          var passInput = document.getElementById("password");
          var confirmInput = document.getElementById("confirmPassword");
          if (passInput) {
            var pass = (passInput.value || "").trim();
            var confirmPass = (confirmInput ? confirmInput.value : "").trim();
            if (!pass || pass.length < 6) {
              showToast("error", "Mật khẩu phải có ít nhất 6 ký tự!");
              btn.disabled = false;
              btn.innerHTML = originalText;
              return;
            }
            if (pass !== confirmPass) {
              showToast("error", "Mật khẩu xác nhận không khớp!");
              btn.disabled = false;
              btn.innerHTML = originalText;
              return;
            }
          }

          var formData = new FormData(regForm);
          var payload = {
            fullName: formData.get("fullName"),
            phone: formData.get("phone"),
            email: formData.get("email"),
            storeName: formData.get("storeName"),
            businessAddress: formData.get("businessAddress"),
            taxCode: formData.get("taxCode"),
            note: formData.get("note"),
            password: formData.get("password") || "",
            confirmPassword: formData.get("confirmPassword") || ""
          };

          try {
            var res = await fetch("/dang-ky-dai-ly", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload)
            });
            var data = await res.json();
            if (data.code === "success") {
              showToast("success", data.message);
              setTimeout(function () {
                window.location.href = data.redirectUrl || "/dang-ky-dai-ly/cho-xac-nhan";
              }, 600);
            } else {
              showToast("error", data.message || "Có lỗi xảy ra!");
              if (data.redirectUrl) {
                setTimeout(function () {
                  window.location.href = data.redirectUrl;
                }, 1200);
              } else {
                btn.disabled = false;
                btn.innerHTML = originalText;
              }
            }
          } catch (err) {
            showToast("error", "Lỗi kết nối máy chủ! Vui lòng thử lại.");
            btn.disabled = false;
            btn.innerHTML = originalText;
          }
        });
      }
    });
