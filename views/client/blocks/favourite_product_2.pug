include ../mixins/product-item-2.pug

//
  ============================
    FAVOURITE PRODUCT 2 START
    ==============================
section(class="favourite_product_2 mt_100")
  .container
    .row
      if blockData && blockData.banner
        .col-xl-3.col-lg-4.wow.fadeInLeft
          div(class="bundle_product_banner")
            img.img-fluid(
              alt=blockData.banner.title ? blockData.banner.title.normal : "banner"
              src=blockData.banner.image
              )
            .text
              if blockData.banner.title
                h4
                  | #{blockData.banner.title.normal}
                  if blockData.banner.title.highlight
                    span #{blockData.banner.title.highlight}
              if blockData.banner.description
                p #{blockData.banner.description}
              if blockData.banner.button
                a(
                  href=blockData.banner.button.link
                  class="common_btn"
                  )
                  | #{blockData.banner.button.text}
                  i.fas.fa-long-arrow-right(aria-hidden="true")
      .col-xl-9.col-lg-8
        .row
          .col-xl-8
            if blockData && blockData.title
              div(class="section_heading_2 section_heading")
                h3
                  if blockData.title.normal1
                    | #{blockData.title.normal1} 
                  if blockData.title.highlight
                    span #{blockData.title.highlight}
                  if blockData.title.normal2
                    |  #{blockData.title.normal2}
          if blockProductList && blockProductList.length
            .row(class="mt_40 favourite_product_2_slider")
              each item in blockProductList
                .col-xl-3.wow.fadeInUp
                  +product-item-2(item)
//
  ============================
    FAVOURITE PRODUCT 2 END
    ==============================
