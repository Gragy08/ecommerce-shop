include ../mixins/product-item-2.pug

//
  ================================
    NEW ARRIVAL 2 START
    ==================================
section(class="new_arrival_2 mt_95")
  .container
    .row
      .col-xl-6.col-sm-9
        if blockData && blockData.title
          div(class="section_heading_2 section_heading")
            h3
              if blockData.title.normal1
                | #{blockData.title.normal1} 
              if blockData.title.highlight
                span #{blockData.title.highlight}
              if blockData.title.normal2
                |  #{blockData.title.normal2}
      .col-xl-6.col-sm-3
        if blockData && blockData.linkViewAll
          div(class="view_all_btn_area")
            a(
              href=blockData.linkViewAll
              class="view_all_btn"
              ) #{blockData.viewAll}
    if blockProductList && blockProductList.length
      .row(class="mt_15")
        each item in blockProductList
          .col-xl-1-5.col-6.col-md-4.col-xl-3.wow.fadeInUp
            +product-item-2(item)
//
  ================================
    NEW ARRIVAL 2 END
    ==================================
