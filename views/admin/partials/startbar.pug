.startbar.d-print-none
  // start brand
  .brand
    a.logo(href=`/${pathAdmin}/dashboard`)
      span
        img.logo-sm(
          alt="logo-small" 
          src="/admin/assets/images/logo-sm.png"
          )
      span
        img.logo-lg.logo-light(
          alt="logo-large" 
          src="/admin/assets/images/logo-light.png"
          style="max-width: 120px; height: auto; padding-top: 15px;"
          )
        img.logo-lg.logo-dark(
          alt="logo-large" 
          src="/admin/assets/images/logo-light.png"
          style="max-width: 120px; height: auto; padding-top: 15px;"
          )
  // end brand
  // start startbar-menu
  .startbar-menu
    #startbarCollapse.startbar-collapse(data-simplebar="")
      .d-flex.align-items-start.flex-column.w-100
        // Navigation
        ul.navbar-nav.mb-auto.w-100
          if (permissions.includes('dashboard'))
            li.nav-item
              a.nav-link(
                aria-controls="sidebarDashboard" 
                aria-expanded="false" 
                role="button" 
                data-bs-toggle="collapse" 
                href="#sidebarDashboard"
                )
                i.iconoir-home-simple.menu-icon
                span Tổng quan
              #sidebarDashboard.collapse
                ul.nav.flex-column
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/dashboard`) Tổng quan KPI
                  // end nav-item
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/dashboard/analytics`) Báo cáo Bán hàng & Lợi nhuận
                  // end nav-item
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/dashboard/revenue-by-time`) Doanh thu theo thời gian
                  // end nav-item
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/dashboard/order-statistic`) Thống kê đơn hàng
                  // end nav-item
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/dashboard/top-selling-products`) Sản phẩm bán chạy
                  // end nav-item
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/dashboard/customer-statistic`) Thống kê khách hàng
                  // end nav-item
          // end nav-item
          if (permissions.includes("coupon-role"))
            li.nav-item
              a.nav-link(
                aria-controls="sidebarProduct" 
                aria-expanded="false" 
                role="button" 
                data-bs-toggle="collapse" 
                href="#sidebarProduct"
                )
                i.iconoir-shop.menu-icon
                span Sản phẩm
              #sidebarProduct.collapse
                ul.nav.flex-column
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/product/create`) Tạo sản phẩm
                  // end nav-item
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/product/list`) Danh sách sản phẩm
                  // end nav-item
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/product/category`) Danh mục sản phẩm
                  // end nav-item
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/product/attribute`) Thuộc tính sản phẩm
                  // end nav-item
          if (permissions.includes("supplier-role") || permissions.includes("inventory-role"))
            li.nav-item
              a.nav-link(
                aria-controls="sidebarInventory" 
                aria-expanded="false" 
                role="button" 
                data-bs-toggle="collapse" 
                href="#sidebarInventory"
                )
                i.iconoir-box-iso.menu-icon
                span Tồn kho
              #sidebarInventory.collapse
                ul.nav.flex-column
                  if (permissions.includes("inventory-list"))
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/inventory/list`) Danh sách tồn kho
                  if (permissions.includes("stock-receipt-list"))
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/inventory/receipt`) Phiếu nhập kho
                  if (permissions.includes("supplier-list"))
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/supplier/list`) Nhà cung cấp
                  if (permissions.includes("inventory-tracker"))
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/inventory/tracker`) Tra cứu IMEI
          if (permissions.includes("article-role"))
            li.nav-item
              a.nav-link(
                aria-controls="sidebarArticle" 
                aria-expanded="false" 
                role="button" 
                data-bs-toggle="collapse" 
                href="#sidebarArticle"
                )
                i.iconoir-journal-page.menu-icon
                span Bài viết
              #sidebarArticle.collapse
                ul.nav.flex-column
                  if (permissions.includes("article-create"))
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/article/create`) Tạo bài viết
                    // end nav-item
                  if (permissions.includes("article-list"))
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/article/list`) Danh sách bài viết
                    // end nav-item
                  if (permissions.includes("article-category"))
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/article/category`) Danh mục bài viết
                    // end nav-item
                // end nav
              // end sidebarArticle
            // end nav-item
          if (permissions.includes("role-role"))
            li.nav-item
              a.nav-link(
                aria-controls="sidebarRole" 
                aria-expanded="false" 
                role="button" 
                data-bs-toggle="collapse" 
                href="#sidebarRole"
                )
                i.iconoir-user-badge-check.menu-icon
                span Nhóm quyền
              #sidebarRole.collapse
                ul.nav.flex-column
                  if (permissions.includes("role-create"))
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/role/create`) Tạo nhóm quyền
                    // end nav-item
                  if (permissions.includes("role-list"))
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/role/list`) Danh sách nhóm quyền
                    // end nav-item
          if (permissions.includes("account-admin-role"))
            li.nav-item
              a.nav-link(
                aria-controls="sidebarAccountAdmin" 
                aria-expanded="false" 
                role="button" 
                data-bs-toggle="collapse" 
                href="#sidebarAccountAdmin"
                )
                i.iconoir-user-crown.menu-icon
                span Tài khoản quản trị
              #sidebarAccountAdmin.collapse
                ul.nav.flex-column
                  if (permissions.includes("account-admin-create"))
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/account-admin/create`) Tạo tài khoản
                    // end nav-item
                  if (permissions.includes("account-admin-list"))
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/account-admin/list`) Danh sách tài khoản
                    // end nav-item
          if (permissions.includes("customer-role"))
            li.nav-item
              a.nav-link(
                aria-controls="sidebarCustomer" 
                aria-expanded="false" 
                role="button" 
                data-bs-toggle="collapse" 
                href="#sidebarCustomer"
                )
                i.iconoir-group.menu-icon
                span Khách hàng
              #sidebarCustomer.collapse
                ul.nav.flex-column
                  if (permissions.includes("customer-list"))
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/customer/list`) Danh sách khách hàng
          if (permissions.includes("wholesale-role") || permissions.includes("wholesale-registration-list") || permissions.includes("wholesale-approval") || permissions.includes("wholesale-setting"))
            li.nav-item
              a.nav-link(
                aria-controls="sidebarWholesale" 
                aria-expanded="false" 
                role="button" 
                data-bs-toggle="collapse" 
                href="#sidebarWholesale"
                )
                i.iconoir-shop.menu-icon
                span Kênh Đại lý (Bán sỉ)
              #sidebarWholesale.collapse
                ul.nav.flex-column
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/wholesale/list`) Danh sách đại lý
                  if (permissions.includes("wholesale-registration-list") || permissions.includes("wholesale-approval"))
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/wholesale/registrations`) Duyệt hồ sơ đại lý
                  if (permissions.includes("wholesale-setting"))
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/wholesale/settings`) Chính sách & Ràng buộc sỉ
          if (permissions.includes("coupon-role"))
            li.nav-item
              a.nav-link(
                aria-controls="sidebarCoupon" 
                aria-expanded="false" 
                role="button" 
                data-bs-toggle="collapse" 
                href="#sidebarCoupon"
                )
                i.iconoir-percentage-circle.menu-icon
                span Mã giảm giá
              #sidebarCoupon.collapse
                ul.nav.flex-column
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/coupon/create`) Tạo mã giảm giá
                  // end nav-item
                  li.nav-item
                    a.nav-link(href=`/${pathAdmin}/coupon/list`) Danh sách mã giảm giá
                  // end nav-item
          li.nav-item
            a.nav-link(
              aria-controls="sidebarOrder" 
              aria-expanded="false" 
              role="button" 
              data-bs-toggle="collapse" 
              href="#sidebarOrder"
              )
              i.iconoir-bag.menu-icon
              span Quản lý đơn hàng
            #sidebarOrder.collapse
              ul.nav.flex-column
                li.nav-item
                  a.nav-link(href=`/${pathAdmin}/order/pos`) Bán hàng tại quầy
                li.nav-item
                  a.nav-link(href=`/${pathAdmin}/order/list`) Danh sách đơn hàng
          if (permissions.includes("warranty-role") || permissions.includes("warranty-list"))
            li.nav-item
              a.nav-link(
                aria-controls="sidebarWarranty" 
                aria-expanded="false" 
                role="button" 
                data-bs-toggle="collapse" 
                href="#sidebarWarranty"
                )
                i.iconoir-wrench.menu-icon
                span Bảo hành - Sửa chữa
              #sidebarWarranty.collapse
                ul.nav.flex-column
                  if (permissions.includes("warranty-create"))
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/warranty/create`) Tiếp nhận bảo hành / sửa chữa
                  if (permissions.includes("warranty-list"))
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/warranty/list`) Danh sách phiếu bảo hành
          li.nav-item
            a.nav-link(
              href=`/${pathAdmin}/review/list`
              )
              i.iconoir-star.menu-icon
              span Quản lý đánh giá
          if (permissions.includes("log-activity-role"))
            li.nav-item
              a.nav-link(
                aria-controls="sidebarLog" 
                aria-expanded="false" 
                role="button" 
                data-bs-toggle="collapse" 
                href="#sidebarLog"
                )
                i.iconoir-clipboard-check.menu-icon
                span Hoạt động quản trị
              #sidebarLog.collapse
                ul.nav.flex-column
                  if (permissions.includes("log-activity-list"))
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/admin-log/list`) Danh sách hoạt động
                    // end nav-item
          if (permissions.includes("file-manager"))
            li.nav-item
              a.nav-link(
                href=`/${pathAdmin}/file-manager/iframe`
                )
                i.iconoir-page-star.menu-icon
                span Quản lý file
          li.nav-item
            a.nav-link(
              href=`/${pathAdmin}/block/list`
              )
              i.iconoir-orthogonal-view.menu-icon
              span Quản lý block
          li.nav-item
            a.nav-link(
              href=`/${pathAdmin}/template/list`
              )
              i.iconoir-orthogonal-view.menu-icon
              span Quản lý template
          li.nav-item
            a.nav-link(
              aria-controls="sidebarChat" 
              aria-expanded="false" 
              role="button" 
              data-bs-toggle="collapse" 
              href="#sidebarChat"
              )
              i.iconoir-chat-bubble.menu-icon
              span Tin nhắn
            #sidebarChat.collapse
              ul.nav.flex-column
                li.nav-item
                  a.nav-link(href=`/${pathAdmin}/chat/list/my-chat`) Của bạn
                // end nav-item
          li.nav-item
            a.nav-link(
              aria-controls="sidebarSetting" 
              aria-expanded="false" 
              role="button" 
              data-bs-toggle="collapse" 
              href="#sidebarSetting"
              )
              i.iconoir-settings.menu-icon
              span Cài đặt
            #sidebarSetting.collapse
              ul.nav.flex-column
                li.nav-item
                  a.nav-link(href=`/${pathAdmin}/setting/api-shipping`) API hãng vận chuyển
                // end nav-item
                li.nav-item
                  a.nav-link(href=`/${pathAdmin}/setting/api-payment`) API cổng thanh toán
                // end nav-item
                li.nav-item
                  a.nav-link(href=`/${pathAdmin}/setting/api-login-social`) API đăng nhập MXH
                // end nav-item
                li.nav-item
                  a.nav-link(href=`/${pathAdmin}/setting/api-app-password`) API Mật khẩu ứng dụng
                // end nav-item
                li.nav-item
                  a.nav-link(href=`/${pathAdmin}/setting/general`) Cài đặt chung
                // end nav-item
                li.nav-item
                  a.nav-link(
                    href="javascript:;"
                    button-api
                    data-method="PATCH"
                    data-api=`/${pathAdmin}/setting/remove-cache`
                  )
                    | Xóa bộ nhớ đệm
                // end nav-item
    // end startbar-collapse
  // end startbar-menu
// end startbar
.startbar-overlay.d-print-none