extends ../layouts/default.pug
include ../mixins/pagination.pug
include ../mixins/form-search.pug

block main
  .row
    .col-12
      .row.mb-3.g-3
        .col-md-3.col-sm-6
          .card.mb-0.h-100
            .card-body.p-3
              .d-flex.align-items-center
                .avatar-sm.bg-primary-subtle.rounded-circle.me-3.d-flex.align-items-center.justify-content-center
                  i.las.la-shopping-bag.fs-3.text-primary
                div
                  h6.text-muted.mb-1 Tổng đơn hàng
                  .d-flex.align-items-baseline.gap-2
                    h4.mb-0 #{stats ? stats.totalOrders : 0}
                    if stats && stats.wholesaleOrdersCount
                      span.badge.bg-warning.text-dark(title="Đơn sỉ đại lý")
                        i.las.la-crown.me-1
                        | #{stats.wholesaleOrdersCount} đơn sỉ
        .col-md-3.col-sm-6
          .card.mb-0.h-100
            .card-body.p-3
              .d-flex.align-items-center
                .avatar-sm.bg-success-subtle.rounded-circle.me-3.d-flex.align-items-center.justify-content-center
                  i.las.la-check-circle.fs-3.text-success
                div
                  h6.text-muted.mb-1 Đơn hoàn thành
                  h4.mb-0 #{stats ? stats.completedOrders : 0}
        .col-md-3.col-sm-6
          .card.mb-0.h-100
            .card-body.p-3
              .d-flex.align-items-center
                .avatar-sm.bg-danger-subtle.rounded-circle.me-3.d-flex.align-items-center.justify-content-center
                  i.las.la-wallet.fs-3.text-danger
                div
                  h6.text-muted.mb-1 Tổng doanh thu
                  h4.mb-0.text-danger #{stats ? stats.totalRevenueFormatted : '0 đ'}
        .col-md-3.col-sm-6
          .card.mb-0.h-100
            .card-body.p-3
              .d-flex.align-items-center
                .avatar-sm.bg-warning-subtle.rounded-circle.me-3.d-flex.align-items-center.justify-content-center
                  i.las.la-file-invoice-dollar.fs-3.text-warning
                div
                  h6.text-muted.mb-1 Chờ đối tác giải ngân (#{stats ? stats.pendingInstallmentCount : 0})
                  h4.mb-0.text-warning #{stats ? stats.pendingInstallmentLoanTotalFormatted : '0 đ'}

      .card
        .card-header
          .row.align-items-center
            .col
              h4.card-title #{pageTitle}
            .col-auto.d-flex.gap-2
              a.btn.btn-primary(href=`/${pathAdmin}/order/pos`)
                i.fa-solid.fa-cash-register.me-1
                | Bán hàng tại quầy
              a.btn.btn-outline-secondary(href=`/${pathAdmin}/order/export/csv`)
                i.fa-solid.fa-file-csv.me-1
                | Xuất CSV
        .card-body.pt-0
          form.row.g-2.mb-3(method="GET" action=`/${pathAdmin}/order/list`)
            .col-lg-3.col-md-6
              input.form-control(
                type="text"
                name="keyword"
                value=(filters && filters.keyword ? filters.keyword : "")
                placeholder="Tìm mã đơn, tên KH, đại lý, SĐT, IMEI..."
              )
            .col-lg-2.col-md-3.col-6
              select.form-select(name="orderType")
                option(value="" selected=(!filters || !filters.orderType)) Tất cả loại đơn
                option(value="wholesale" selected=(filters && filters.orderType == "wholesale")) 👑 Đại lý (Sỉ)
                option(value="retail" selected=(filters && filters.orderType == "retail")) Khách lẻ
            .col-lg-2.col-md-3.col-6
              select.form-select(name="channel")
                option(value="" selected=(!filters || !filters.channel)) Tất cả kênh bán
                option(value="pos" selected=(filters && filters.channel == "pos")) Tại quầy POS
                option(value="online" selected=(filters && filters.channel == "online")) Online Web
            .col-lg-2.col-md-3.col-6
              select.form-select(name="paymentMethod")
                option(value="" selected=(!filters || !filters.paymentMethod)) Tất cả thanh toán
                option(value="money" selected=(filters && filters.paymentMethod == "money")) Tiền mặt
                option(value="bank_transfer" selected=(filters && filters.paymentMethod == "bank_transfer")) Chuyển khoản
                option(value="installment" selected=(filters && filters.paymentMethod == "installment")) Trả góp
                option(value="vnpay" selected=(filters && filters.paymentMethod == "vnpay")) VNPay
                option(value="zalopay" selected=(filters && filters.paymentMethod == "zalopay")) ZaloPay
            .col-lg-2.col-md-4.col-6
              select.form-select(name="orderStatus")
                option(value="" selected=(!filters || !filters.orderStatus)) Tất cả TT đơn
                option(value="pending" selected=(filters && filters.orderStatus == "pending")) Chờ xác nhận
                option(value="confirmed" selected=(filters && filters.orderStatus == "confirmed")) Đã xác nhận
                option(value="shipping" selected=(filters && filters.orderStatus == "shipping")) Đang giao
                option(value="completed" selected=(filters && filters.orderStatus == "completed")) Hoàn thành
                option(value="returned" selected=(filters && filters.orderStatus == "returned")) Trả hàng
                option(value="cancelled" selected=(filters && filters.orderStatus == "cancelled")) Đã hủy
            .col-lg-3.col-md-8.col-6.d-flex.gap-2
              select.form-select(name="settlementStatus")
                option(value="" selected=(!filters || !filters.settlementStatus)) Giải ngân trả góp
                option(value="pending" selected=(filters && filters.settlementStatus == "pending")) Chờ đối tác giải ngân
                option(value="settled" selected=(filters && filters.settlementStatus == "settled")) Đã giải ngân
              button.btn.btn-primary.px-3(type="submit" title="Tìm kiếm & Lọc")
                i.fa-solid.fa-magnifying-glass
              a.btn.btn-light.border(href=`/${pathAdmin}/order/list` title="Xóa bộ lọc")
                i.fa-solid.fa-rotate-left
          .table-responsive
            table.table.table-striped.align-middle.mb-0
              thead.table-light
                tr
                  th STT
                  th Mã đơn
                  th Kênh bán
                  th Khách hàng
                  th.text-end Tổng tiền
                  th Thanh toán
                  th TT thanh toán
                  th TT đơn hàng
                  th Ngày tạo
                  th.text-end Hành động
              tbody
                if (recordList && recordList.length > 0)
                  each item, index in recordList
                    tr
                      td #{pagination.skip + index + 1}
                      td
                        .d-flex.align-items-center.flex-wrap.gap-1
                          a.fw-bold.text-primary.text-decoration-none(href=`/${pathAdmin}/order/edit/${item.id}`) #{item.code}
                          if (item.orderType === "wholesale")
                            span.badge.bg-warning.text-dark(title="Đơn hàng đại lý sỉ")
                              i.las.la-crown.me-1
                              | Đơn sỉ
                      td
                        if (item.channel == "pos")
                          span.badge.bg-info Tại quầy POS
                        else
                          span.badge.bg-primary Online Web
                      td
                        if (item.customerId)
                          a.fw-semibold.text-dark.text-decoration-none.d-block(href=`/${pathAdmin}/customer/detail/${item.customerId}`) #{item.fullName}
                        else
                          div.fw-semibold #{item.fullName}
                        if (item.storeName)
                          span.badge.bg-warning-subtle.text-dark.border.border-warning.d-inline-flex.align-items-center.gap-1.my-1
                            i.las.la-store.text-warning-emphasis
                            span.fw-semibold #{item.storeName}
                        small.text-muted.d-block #{item.phone}
                      td.text-end.fw-bold.text-danger #{item.totalFormatted}
                      td
                        case item.paymentMethod
                          when "money"
                            span.badge.bg-secondary Tiền mặt
                          when "vnpay"
                            span.badge.bg-danger VNPay
                          when "zalopay"
                            span.badge.bg-primary ZaloPay
                          when "bank_transfer"
                            span.badge.bg-info Chuyển khoản
                          when "credit_card"
                            span.badge.bg-dark Quẹt thẻ
                          when "installment"
                            span.badge.bg-warning.text-dark Trả góp
                            if item.installmentInfo
                              - const provLabel = item.installmentInfo.provider === 'home_credit' ? 'Home Credit' : item.installmentInfo.provider === 'mirae_asset' ? 'Mirae Asset' : 'HD Saison';
                              .small.text-muted.mt-1 #{provLabel} (#{item.installmentInfo.termMonths || 6}T)
                              if item.installmentInfo.settlementStatus === "settled"
                                span.badge.bg-success-subtle.text-success.mt-1 Đã giải ngân
                              else
                                span.badge.bg-warning-subtle.text-warning.mt-1 Chờ giải ngân: #{Number(item.installmentInfo.loanAmount || 0).toLocaleString('vi-VN')} đ
                          default
                            span.badge.bg-secondary Tiền mặt
                      td
                        case item.paymentStatus
                          when "unpaid"
                            span.badge.bg-warning.text-dark Chưa thanh toán
                          when "paid"
                            span.badge.bg-success Đã thanh toán
                          when "refunded"
                            span.badge.bg-info Đã hoàn tiền
                      td
                        case item.orderStatus
                          when "pending"
                            span.badge.bg-secondary Chờ xác nhận
                          when "confirmed"
                            span.badge.bg-primary Đã xác nhận
                          when "shipping"
                            span.badge.bg-info Đang giao
                          when "completed"
                            span.badge.bg-success Hoàn thành
                          when "cancelled"
                            span.badge.bg-danger Đã hủy
                          when "returned"
                            span.badge.bg-dark Trả hàng
                      td #{item.createdAtFormat}
                      td.text-end
                        a.me-1(href=`/${pathAdmin}/order/print/${item.id}` title="In hóa đơn")
                          i.las.la-print.text-secondary.fs-20
                        a.me-1(href=`/${pathAdmin}/order/edit/${item.id}` title="Chi tiết / Cập nhật")
                          i.las.la-pen.text-secondary.fs-20
                        a(
                          href="javascript:;"
                          button-api
                          data-method="PATCH"
                          data-api=`/${pathAdmin}/order/delete/${item.id}`
                          title="Xóa"
                        )
                          i.las.la-trash-alt.text-secondary.fs-20
                else
                  tr
                    td.text-center.text-muted.py-4(colspan="10") Chưa có đơn hàng nào.
          +pagination()
