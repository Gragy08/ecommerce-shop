extends ../layouts/default.pug

block main
  if permissions.includes('supplier-create')
    .card
      .card-header
        .row.align-items-center
          .col
            h4.card-title #{pageTitle}
      .card-body.pt-0
        form(id="supplierCreateForm")
          .row
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="name") Tên nhà cung cấp *
                input.form-control(id="name" type="text" name="name")
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="phone") Số điện thoại *
                input.form-control(id="phone" type="text" name="phone")
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="email") Email
                input.form-control(id="email" type="email" name="email")
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="contactPerson") Người đại diện
                input.form-control(id="contactPerson" type="text" name="contactPerson")
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="address") Địa chỉ
                input.form-control(id="address" type="text" name="address")
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="status") Trạng thái
                select.form-select(id="status" name="status")
                  option(value="active") Hoạt động
                  option(value="inactive") Tạm dừng
            .col-12
              .mb-3
                label.form-label(for="notes") Ghi chú
                textarea.form-control(id="notes" name="notes" rows="3")
          button.btn.btn-primary(type="submit") Tạo mới
          a.btn.btn-danger.ms-1(href=`/${pathAdmin}/supplier/list`) Hủy
