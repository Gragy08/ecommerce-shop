extends ../layouts/default.pug
include ../mixins/pagination.pug

block main
  .row.g-3.mb-3
    .col-md-3.col-6
      .card.mb-0.h-100
        .card-body.p-3
          .d-flex.align-items-center
            .avatar-sm.bg-primary-subtle.rounded-circle.me-3.d-flex.align-items-center.justify-content-center
              i.las.la-clipboard-list.fs-3.text-primary
            div
              h6.text-muted.mb-1 Tổng phiếu tiếp nhận
              h4.mb-0 #{stats ? stats.totalTickets : 0}
    .col-md-3.col-6
      .card.mb-0.h-100
        .card-body.p-3
          .d-flex.align-items-center
            .avatar-sm.bg-warning-subtle.rounded-circle.me-3.d-flex.align-items-center.justify-content-center
              i.las.la-tools.fs-3.text-warning
            div
              h6.text-muted.mb-1 Đang kiểm tra / sửa chữa
              h4.mb-0.text-warning #{stats ? stats.processingCount : 0}
    .col-md-3.col-6
      .card.mb-0.h-100
        .card-body.p-3
          .d-flex.align-items-center
            .avatar-sm.bg-info-subtle.rounded-circle.me-3.d-flex.align-items-center.justify-content-center
              i.las.la-check-circle.fs-3.text-info
            div
              h6.text-muted.mb-1 Đã xong (Chờ trả khách)
              h4.mb-0.text-info #{stats ? stats.completedCount : 0}
    .col-md-3.col-6
      .card.mb-0.h-100
        .card-body.p-3
          .d-flex.align-items-center
            .avatar-sm.bg-success-subtle.rounded-circle.me-3.d-flex.align-items-center.justify-content-center
              i.las.la-handshake.fs-3.text-success
            div
              h6.text-muted.mb-1 Đã trả khách / Đổi 1-1
              h4.mb-0.text-success #{stats ? stats.returnedCount : 0}

  .card.mb-3
    .card-header
      .row.align-items-center
        .col
          h4.card-title.mb-0 #{pageTitle}
        .col-auto
          a.btn.btn-primary(href=`/${pathAdmin}/warranty/create`)
            i.fa-solid.fa-plus.me-1
            | Tiếp nhận bảo hành / sửa chữa
    .card-body.pt-0
      form.row.g-2.mb-3(method="GET" action=`/${pathAdmin}/warranty/list`)
        .col-md-4
          input.form-control(
            type="text"
            name="keyword"
            value=(filters && filters.keyword ? filters.keyword : "")
            placeholder="Tìm mã phiếu, IMEI, SĐT, tên khách, tên máy..."
          )
        .col-md-3
          select.form-select(name="warrantyType")
            option(value="" selected=(!filters || !filters.warrantyType)) Tất cả phân loại
            option(value="warranty" selected=(filters && filters.warrantyType === "warranty")) Bảo hành tiêu chuẩn
            option(value="repair" selected=(filters && filters.warrantyType === "repair")) Sửa chữa dịch vụ
            option(value="exchange" selected=(filters && filters.warrantyType === "exchange")) Đổi mới 1-1
        .col-md-3
          select.form-select(name="status")
            option(value="" selected=(!filters || !filters.status)) Tất cả trạng thái
            option(value="received" selected=(filters && filters.status === "received")) Mới tiếp nhận
            option(value="inspecting" selected=(filters && filters.status === "inspecting")) Đang kiểm tra / sửa chữa
            option(value="waiting_parts" selected=(filters && filters.status === "waiting_parts")) Chờ linh kiện
            option(value="completed" selected=(filters && filters.status === "completed")) Đã xong - Chờ trả khách
            option(value="returned" selected=(filters && filters.status === "returned")) Đã bàn giao khách
            option(value="cancelled" selected=(filters && filters.status === "cancelled")) Đã hủy
        .col-md-2.d-flex.gap-2
          button.btn.btn-primary.flex-grow-1(type="submit")
            i.fa-solid.fa-magnifying-glass.me-1
            | Lọc
          a.btn.btn-light.border(href=`/${pathAdmin}/warranty/list` title="Xóa bộ lọc")
            i.fa-solid.fa-rotate-left

      // Thanh thao tác hàng loạt
      #bulkActionBar.alert.alert-primary.py-2.px-3.mb-3.align-items-center.justify-content-between.flex-wrap.gap-2(style="display: none;")
        .d-flex.align-items-center.gap-2
          i.fa-solid.fa-check-double
          span
            | Đã chọn 
            strong#selectedTicketsCount 0
            |  phiếu bảo hành
        .d-flex.align-items-center.gap-2.flex-wrap
          select#bulkStatusSelect.form-select.form-select-sm(style="width: 210px;")
            option(value="") -- Chọn trạng thái --
            option(value="inspecting") Đang kiểm tra / sửa chữa
            option(value="waiting_parts") Chờ linh kiện
            option(value="completed") Đã xong - Chờ trả khách
            option(value="returned") Đã bàn giao trả khách
            option(value="cancelled") Hủy phiếu
          input#bulkResolutionNote.form-control.form-control-sm(
            type="text"
            placeholder="Ghi chú xử lý chung (tùy chọn)..."
            style="width: 240px;"
          )
          button#btnApplyBulkStatus.btn.btn-primary.btn-sm(type="button")
            | Cập nhật hàng loạt

      .table-responsive
        table.table.table-striped.align-middle.mb-0
          thead.table-light
            tr
              th.text-center(style="width: 40px")
                input#checkAllWarranty.form-check-input(type="checkbox")
              th Mã phiếu
              th Thiết bị & Mã IMEI
              th Khách hàng
              th Mô tả lỗi
              th Phân loại
              th.text-end Chi phí
              th Trạng thái
              th Ngày nhận
              th.text-end Thao tác
          tbody
            if (tickets && tickets.length > 0)
              each item in tickets
                tr
                  td.text-center
                    input.form-check-input.warranty-row-checkbox(type="checkbox" value=item._id)
                  td
                    a.fw-bold.text-primary.text-decoration-none(href=`/${pathAdmin}/warranty/detail/${item._id}`) #{item.ticketCode}
                    if item.isExternalDevice
                      span.badge.bg-secondary.d-block.mt-1(style="width: fit-content") Máy ngoài
                  td
                    .fw-semibold #{item.productName}
                    if item.variantName
                      small.text-muted.d-block #{item.variantName}
                    code.text-dark #{item.identifier}
                    if item.replacementIdentifier
                      .small.text-success.fw-semibold.mt-1
                        i.fa-solid.fa-rotate.me-1
                        | Đổi mới: #{item.replacementIdentifier}
                  td
                    .fw-semibold #{item.customerInfo ? item.customerInfo.fullName : '-'}
                    small.text-muted #{item.customerInfo ? item.customerInfo.phone : ''}
                  td(style="max-width: 220px;")
                    .text-truncate(title=item.issueDescription) #{item.issueDescription}
                    if item.deviceCondition
                      small.text-muted.d-block.text-truncate Tình trạng: #{item.deviceCondition}
                  td
                    case item.warrantyType
                      when "warranty"
                        span.badge.bg-primary-subtle.text-primary Bảo hành
                      when "repair"
                        span.badge.bg-warning-subtle.text-warning Sửa chữa
                      when "exchange"
                        span.badge.bg-danger-subtle.text-danger Đổi mới 1-1
                  td.text-end
                    if item.totalAmount > 0
                      strong.text-danger #{Number(item.totalAmount).toLocaleString('vi-VN')} đ
                    else
                      span.text-success.fw-semibold Miễn phí
                  td
                    case item.status
                      when "received"
                        span.badge.bg-secondary Mới tiếp nhận
                      when "inspecting"
                        span.badge.bg-info.text-dark Đang kiểm tra / sửa
                      when "waiting_parts"
                        span.badge.bg-warning.text-dark Chờ linh kiện
                      when "completed"
                        span.badge.bg-primary Đã xong - Chờ trả
                      when "returned"
                        span.badge.bg-success Đã trả khách
                      when "cancelled"
                        span.badge.bg-danger Đã hủy
                  td
                    div #{moment(item.createdAt).format("DD/MM/YYYY")}
                    small.text-muted #{moment(item.createdAt).format("HH:mm")}
                  td.text-end
                    a.btn.btn-sm.btn-outline-primary(href=`/${pathAdmin}/warranty/detail/${item._id}`)
                      i.fa-solid.fa-eye.me-1
                      | Chi tiết
            else
              tr
                td.text-center.text-muted.py-4(colspan="10") Chưa có phiếu bảo hành / sửa chữa nào.

      +pagination()

block script
  script(src="/admin/assets/js/warranty-list.js")
