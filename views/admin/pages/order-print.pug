extends ../layouts/default.pug

block main
  style.
    @media print {
      .startbar, .topbar, .footer, .no-print {
        display: none !important;
      }
      .page-wrapper, .page-content, .container-fluid {
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
      }
      body[data-print-mode="k80"] #printAreaA4 {
        display: none !important;
      }
      body[data-print-mode="k80"] #printAreaK80 {
        display: block !important;
        width: 78mm !important;
        margin: 0 auto !important;
        box-shadow: none !important;
        border: none !important;
      }
      body[data-print-mode="a4"] #printAreaK80 {
        display: none !important;
      }
      body[data-print-mode="a4"] #printAreaA4 {
        display: block !important;
        width: 100% !important;
        box-shadow: none !important;
        border: none !important;
      }
    }

  .row.no-print.mb-3
    .col-12
      .card
        .card-body.p-3.d-flex.justify-content-between.align-items-center.flex-wrap.gap-2
          .d-flex.align-items-center.gap-2
            h4.card-title.mb-0 In hóa đơn: #{order.code}
            span.badge.bg-success Đã hoàn tất
          .d-flex.gap-2
            button.btn.btn-success(type="button" onclick="printInvoiceMode('k80')")
              | In hóa đơn nhiệt K80
            button.btn.btn-outline-success(type="button" onclick="printInvoiceMode('a4')")
              | In hóa đơn khổ A4
            a.btn.btn-primary(href=`/${pathAdmin}/order/pos`)
              i.fas.fa-plus.me-1
              | Tạo đơn mới
            a.btn.btn-secondary(href=`/${pathAdmin}/order/edit/${order.id}`)
              | Chi tiết đơn
              i.fas.fa-arrow-right.ms-1

  .row.g-4
    // Khổ A4 bên trái
    .col-lg-8#printAreaA4
      .card.border
        .card-body.p-4
          .d-flex.justify-content-between.border-bottom.pb-3.mb-3
            div
              h4.fw-bold.mb-1 CỬA HÀNG TỶ PHÚ QUÝ
              div.text-muted.small Địa chỉ: 509 Nguyễn Trung Trực, Rạch Giá, An Giang
              div.text-muted.small Điện thoại: 0982.887.761
            .text-end
              h4.fw-bold.text-primary.mb-1
                if order.orderType === 'wholesale'
                  | PHIẾU XUẤT KHO KIÊM BÀN GIAO HÀNG SỈ
                else
                  | HÓA ĐƠN BÁN HÀNG
              div.small Mã phiếu: 
                strong #{order.code}
              if order.orderType === 'wholesale'
                div.badge.bg-primary.text-white.mb-1 Đơn bán sỉ đại lý
              div.small Ngày lập: #{order.createdAtFormat}
              if order.cashierName
                div.small Người lập: #{order.cashierName}

          .row.mb-3
            .col-6
              if order.orderType === 'wholesale'
                div.small.text-muted Đại lý nhận hàng:
                strong.fs-6 #{order.storeName || order.fullName}
                if order.storeName && order.fullName
                  div.small Người đại diện: #{order.fullName}
                if order.phone
                  div.small SĐT: #{order.phone}
                if order.taxCode
                  div.small MST: #{order.taxCode}
                div.small Địa chỉ nhận: #{order.address || order.businessAddress || 'Nhận trực tiếp tại kho'}
              else
                div.small.text-muted Khách hàng:
                strong #{order.fullName}
                if order.storeName
                  div.small.fw-bold.text-dark Cửa hàng / Đại lý: #{order.storeName}
                if order.phone
                  div.small SĐT: #{order.phone}
                if order.address
                  div.small Địa chỉ: #{order.address}
            .col-6.text-end
              div.small.text-muted Hình thức thanh toán:
              strong
                case order.paymentMethod
                  when "debt"
                    | Công nợ / Thanh toán sau
                  when "money"
                    | Tiền mặt
                  when "bank_transfer"
                    | Chuyển khoản ngân hàng
                  when "credit_card"
                    | Quẹt thẻ POS
                  when "installment"
                    | Trả góp
                  when "vnpay"
                    | VNPay
                  when "zalopay"
                    | ZaloPay
                  default
                    | #{order.paymentMethod || 'Tiền mặt'}
              div.small Trạng thái thanh toán: 
                strong
                  case order.paymentStatus
                    when "paid"
                      span.text-success Đã thanh toán đủ (100%)
                    when "partially_paid"
                      span.text-warning Đã thanh toán 1 phần
                    when "unpaid"
                      span.text-danger Ghi nhận công nợ
                    when "refunded"
                      span.text-secondary Đã hoàn tiền
                    default
                      span Chưa thanh toán
              div.small Kênh bán: #{order.channel == 'pos' ? 'Tại Cửa hàng' : 'Online Web'}

          table.table.table-bordered.table-sm.align-middle.mb-3
            thead.table-light
              tr
                th.text-center(style="width: 45px") STT
                th #{order.orderType === 'wholesale' ? 'Sản phẩm & Biến thể / Danh sách IMEI' : 'Sản phẩm'}
                th.text-center(style="width: 70px") SL
                th.text-end(style="width: 130px") #{order.orderType === 'wholesale' ? 'Đơn giá sỉ' : 'Đơn giá'}
                th.text-end(style="width: 140px") Thành tiền
            tbody
              each item, idx in order.items
                tr
                  td.text-center #{idx + 1}
                  td
                    .fw-semibold #{item.name}
                    if item.variant && item.variant.length > 0
                      small.text-muted.d-block #{item.variant.join(' | ')}
                    if item.identifiers && item.identifiers.length > 0
                      .mt-1.p-1.border.rounded.bg-light
                        span.small.fw-bold.d-block.mb-1 Danh sách IMEI xuất kho (#{item.identifiers.length}):
                        .d-flex.flex-wrap.gap-1
                          each imei in item.identifiers
                            span.badge.border.text-dark.bg-white.font-monospace #{imei}
                  td.text-center #{item.quantity}
                  td.text-end #{(item.price || 0).toLocaleString('vi-VN')} đ
                  td.text-end.fw-semibold #{((item.price || 0) * (item.quantity || 1) - (item.discount || 0)).toLocaleString('vi-VN')} đ

          .row.justify-content-end
            .col-md-6
              .d-flex.justify-content-between.mb-1
                span Tạm tính:
                strong #{(order.subTotal || 0).toLocaleString('vi-VN')} đ
              if order.discount > 0
                .d-flex.justify-content-between.mb-1
                  span Giảm giá:
                  strong -#{order.discount.toLocaleString('vi-VN')} đ
              if order.pointDiscount > 0
                .d-flex.justify-content-between.mb-1
                  span Giảm điểm:
                  strong -#{order.pointDiscount.toLocaleString('vi-VN')} đ
              if order.shipping && order.shipping.fee > 0
                .d-flex.justify-content-between.mb-1
                  span Phí vận chuyển:
                  strong +#{order.shipping.fee.toLocaleString('vi-VN')} đ
              .d-flex.justify-content-between.border-top.pt-2.mt-2
                span.fw-bold Tổng thanh toán:
                h5.fw-bold.text-danger.mb-0 #{(order.total || 0).toLocaleString('vi-VN')} đ
              if order.paymentMethod === "installment" && order.installmentInfo
                - const provNameA4 = order.installmentInfo.provider === 'home_credit' ? 'Home Credit' : order.installmentInfo.provider === 'mirae_asset' ? 'Mirae Asset' : 'HD Saison';
                .border.rounded.p-2.mt-2.bg-light.small
                  .d-flex.justify-content-between
                    span Đơn vị trả góp:
                    strong #{provNameA4} (#{order.installmentInfo.termMonths || 6} tháng)
                  if order.installmentInfo.contractCode
                    .d-flex.justify-content-between
                      span Mã hợp đồng:
                      strong #{order.installmentInfo.contractCode}
                  .d-flex.justify-content-between
                    span Khách trả trước:
                    strong #{(order.installmentInfo.downPayment || 0).toLocaleString('vi-VN')} đ
                  .d-flex.justify-content-between.text-primary
                    span Khoản vay giải ngân:
                    strong #{(order.installmentInfo.loanAmount || 0).toLocaleString('vi-VN')} đ
              else if order.orderType === "wholesale" || order.paymentMethod === "debt" || order.paidAmount > 0 || order.remainingDebt > 0
                .border.rounded.p-2.mt-2.bg-light.small
                  .d-flex.justify-content-between
                    span Đã thanh toán (Trả trước):
                    strong.text-success #{(order.paidAmount || 0).toLocaleString('vi-VN')} đ
                  if order.remainingDebt > 0
                    .d-flex.justify-content-between.mt-1
                      span.fw-bold.text-danger Công nợ còn lại:
                      strong.text-danger #{(order.remainingDebt || 0).toLocaleString('vi-VN')} đ
                  else
                    .d-flex.justify-content-between.mt-1
                      span Tình trạng:
                      strong.text-success Đã tất toán đủ 100%
              else if order.paymentMethod === "money" && order.paidAmount > 0
                .d-flex.justify-content-between.mt-1.small
                  span Tiền khách đưa:
                  span #{(order.paidAmount || 0).toLocaleString('vi-VN')} đ
                if order.changeAmount > 0
                  .d-flex.justify-content-between.small
                    span Tiền thừa trả khách:
                    span #{(order.changeAmount || 0).toLocaleString('vi-VN')} đ

          if order.orderType === 'wholesale'
            .mt-3.p-2.border.rounded.bg-light.text-center.small.fst-italic
              | "Hai bên đã kiểm tra đầy đủ số lượng, quy cách và toàn bộ mã IMEI thiết bị niêm phong nguyên vẹn khi bàn giao."
            .row.mt-4.text-center
              .col-4
                strong Đại lý / Người nhận hàng
                .text-muted.small (Ký và ghi rõ họ tên)
              .col-4
                strong Người lập phiếu / Xuất kho
                .text-muted.small (Ký và ghi rõ họ tên)
              .col-4
                strong Đại diện Cửa hàng Tỷ Phú Quý
                .text-muted.small (Ký và đóng dấu xác nhận)
          else
            .row.mt-5.text-center
              .col-6
                strong Khách hàng
                .text-muted.small (Ký và ghi rõ họ tên)
              .col-6
                strong Người lập phiếu
                .text-muted.small (Ký và ghi rõ họ tên)

    // Khổ nhiệt K80 bên phải
    .col-lg-4#printAreaK80
      .card.border.mx-auto(style="max-width: 320px; font-family: monospace; font-size: 13px;")
        .card-body.p-3
          .text-center.border-bottom.pb-2.mb-2
            .fw-bold.fs-16 Cửa Hàng Tỷ Phú Quý
            div 509 Nguyễn Trung Trực, Rạch Giá
            div SĐT: 0982.887.761
            .fw-bold.mt-2
              if order.orderType === 'wholesale'
                | PHIẾU XUẤT KHO BÁN SỈ
              else
                | HÓA ĐƠN BÁN HÀNG
            div Mã: #{order.code}
            if order.orderType === 'wholesale'
              div [ĐƠN SỈ ĐẠI LÝ]
            div Ngày: #{order.createdAtFormat}

          .border-bottom.pb-2.mb-2
            if order.orderType === 'wholesale'
              if order.storeName
                div.fw-bold Cửa hàng: #{order.storeName}
              div Đại diện: #{order.fullName}
              if order.phone
                div SĐT: #{order.phone}
              if order.taxCode
                div MST: #{order.taxCode}
            else
              div Khách: #{order.fullName}
              if order.storeName
                div Cửa hàng: #{order.storeName}
              if order.phone
                div SĐT: #{order.phone}
            if order.cashierName
              div Thu ngân: #{order.cashierName}

          .border-bottom.pb-2.mb-2
            each item in order.items
              .mb-2
                .fw-bold #{item.name}
                if item.variant && item.variant.length > 0
                  .small.text-muted #{item.variant.join(' | ')}
                if item.identifiers && item.identifiers.length > 0
                  .small IMEI: #{item.identifiers.join(', ')}
                .d-flex.justify-content-between
                  span #{item.quantity} x #{(item.price || 0).toLocaleString('vi-VN')}
                  strong #{((item.price || 0) * (item.quantity || 1) - (item.discount || 0)).toLocaleString('vi-VN')} đ

          .mb-2
            .d-flex.justify-content-between
              span Tạm tính:
              span #{(order.subTotal || 0).toLocaleString('vi-VN')} đ
            if order.discount > 0
              .d-flex.justify-content-between
                span Giảm giá:
                span -#{order.discount.toLocaleString('vi-VN')} đ
            .d-flex.justify-content-between.fw-bold.fs-14.border-top.pt-1.mt-1
              span TỔNG CỘNG:
              span #{(order.total || 0).toLocaleString('vi-VN')} đ
            if order.paymentMethod === "installment" && order.installmentInfo
              - const provNameK80 = order.installmentInfo.provider === 'home_credit' ? 'Home Credit' : order.installmentInfo.provider === 'mirae_asset' ? 'Mirae Asset' : 'HD Saison';
              .border-top.pt-1.mt-1.small
                .d-flex.justify-content-between
                  span Trả góp:
                  strong #{provNameK80} (#{order.installmentInfo.termMonths || 6}T)
                if order.installmentInfo.contractCode
                  .d-flex.justify-content-between
                    span Mã HĐ:
                    span #{order.installmentInfo.contractCode}
                .d-flex.justify-content-between
                  span Trả trước:
                  span #{(order.installmentInfo.downPayment || 0).toLocaleString('vi-VN')} đ
                .d-flex.justify-content-between
                  span Khoản vay:
                  strong #{(order.installmentInfo.loanAmount || 0).toLocaleString('vi-VN')} đ
            else if order.orderType === "wholesale" || order.paymentMethod === "debt" || order.paidAmount > 0 || order.remainingDebt > 0
              .border-top.pt-1.mt-1.small
                .d-flex.justify-content-between
                  span Đã thanh toán:
                  strong #{(order.paidAmount || 0).toLocaleString('vi-VN')} đ
                if order.remainingDebt > 0
                  .d-flex.justify-content-between
                    span Còn nợ:
                    strong #{(order.remainingDebt || 0).toLocaleString('vi-VN')} đ
                else
                  .d-flex.justify-content-between
                    span Còn nợ:
                    strong 0 đ (Đủ)
            else if order.paymentMethod === "money" && order.paidAmount > 0
              .d-flex.justify-content-between.small
                span Khách đưa:
                span #{(order.paidAmount || 0).toLocaleString('vi-VN')} đ
              if order.changeAmount > 0
                .d-flex.justify-content-between.small
                  span Tiền thừa:
                  span #{(order.changeAmount || 0).toLocaleString('vi-VN')} đ

          if order.orderType === 'wholesale'
            .text-center.border-top.pt-2.mt-2.small
              div.fst-italic Đã kiểm đủ SL & IMEI khi nhận hàng
              div Cảm ơn Quý Đại lý đã hợp tác!
          else
            .text-center.border-top.pt-2.mt-2.small
              div Cảm ơn Quý khách & Hẹn gặp lại!

  script.
    function printInvoiceMode(mode) {
      document.body.setAttribute('data-print-mode', mode);
      window.print();
    }
    document.body.setAttribute('data-print-mode', 'k80');
