extends ../layouts/default.pug
include ../mixins/pagination.pug
include ../mixins/form-search.pug

block main
  if permissions.includes('log-activity-list')
    .row
      .col-12
        .card
          .card-header
            .row.align-items-center
              .col
                h4.card-title #{pageTitle}
              // end col
              
              // end col
            // end row
          // end card-header
          .card-body.pt-0
            .row.align-items-center.mb-2
              .col-md-5.col-lg-4
                +form-search()
            .table-responsive
              table.table.table-striped.align-middle.mb-0
                thead.table-light
                  tr
                    th.text-center(style="width: 50px") STT
                    th.text-center(style="width: 60px") Avatar
                    th(style="width: 130px") Tên Admin
                    th(style="width: 140px") Admin ID
                    th Mô tả hành động
                    th.text-center(style="width: 80px") Method
                    th(style="width: 220px") Route
                    th.text-end(style="width: 140px") Thời gian
                tbody
                  if (recordList && recordList.length > 0)
                    each item, index in recordList
                      tr
                        td.text-center #{pagination.skip + index + 1}
                        td.text-center
                          if(item.avatar)
                            img.rounded-circle(
                              src=`${domainCDN}${item.avatar}`
                              width="36"
                              height="36"
                              style="object-fit: cover;"
                            )
                          else
                            img.rounded-circle(
                              src=`${item.avatarSuperAdmin ? item.avatarSuperAdmin : item.avatarUnknown}`
                              width="36"
                              height="36"
                              style="object-fit: cover;"
                            )
                        td
                          span.fw-semibold #{item.name}
                        td
                          code.text-muted.small(style="word-break: break-all; display: inline-block; max-width: 140px;") #{item.adminId}
                        td
                          span #{item.title}
                        td.text-center
                          case item.method
                            when "POST"
                              span.badge.bg-success.text-white POST
                            when "PATCH"
                              span.badge.bg-warning.text-dark PATCH
                            when "PUT"
                              span.badge.bg-info.text-dark PUT
                            when "DELETE"
                              span.badge.bg-danger.text-white DELETE
                            default
                              span.badge.bg-secondary #{item.method || 'GET'}
                        td
                          code.text-dark.small(style="word-break: break-all; display: inline-block; max-width: 220px;") #{item.route}
                        td.text-end.text-nowrap
                          span.small.text-muted #{item.formattedCreatedAt}
                  else
                    tr
                      td.text-center.text-muted.py-4(colspan="8") Chưa có lịch sử hoạt động nào.
            +pagination()
      // end col