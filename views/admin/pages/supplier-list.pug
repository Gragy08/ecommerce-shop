extends ../layouts/default.pug
include ../mixins/pagination.pug
include ../mixins/form-search.pug

block main
  .row
    .col-12
      .card
        .card-header
          .row.align-items-center
            .col
              h4.card-title #{pageTitle}
            if (permissions.includes("supplier-create"))
              .col-auto
                a.btn.btn-primary(
                  href=`/${pathAdmin}/supplier/create`
                )
                  i.fa-solid.fa-plus.me-1
                  | Tạo nhà cung cấp
        .card-body.pt-0
          .row
            .col-lg-6
              +form-search()
          .table-responsive
            table.table.table-striped.mb-0
              thead.table-light
                tr
                  th STT
                  th Tên nhà cung cấp
                  th Số điện thoại
                  th Email
                  th Địa chỉ
                  th Người đại diện
                  th Trạng thái
                  th Ngày tạo
                  th.text-end Hành động
              tbody
                if (recordList && recordList.length > 0)
                  each item, index in recordList
                    tr
                      td #{pagination.skip + index + 1}
                      td #{item.name}
                      td #{item.phone}
                      td #{item.email || '-'}
                      td #{item.address || '-'}
                      td #{item.contactPerson || '-'}
                      td
                        if (item.status == "active")
                          span.badge.bg-success Hoạt động
                        else if (item.status == "inactive")
                          span.badge.bg-danger Tạm dừng
                      td #{item.createdAtFormat || '-'}
                      td.text-end
                        if (permissions.includes("supplier-edit"))
                          a(href=`/${pathAdmin}/supplier/edit/${item._id}`)
                            i.las.la-pen.text-secondary.fs-20
                        if (permissions.includes("supplier-delete"))
                          a(
                            href="javascript:;"
                            button-api
                            data-method="PATCH"
                            data-api=`/${pathAdmin}/supplier/delete/${item._id}`
                          )
                            i.las.la-trash-alt.text-secondary.fs-20
                else
                  tr
                    td.text-center.text-muted.py-4(colspan="9") Chưa có nhà cung cấp nào.
          +pagination()
