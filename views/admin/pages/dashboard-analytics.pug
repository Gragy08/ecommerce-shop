extends ../layouts/default.pug

block main
  if (permissions.includes("dashboard"))
    // Header & Filter Toolbar
    .row.align-items-center.mb-3
      .col-md-6
        h4.page-title.mb-1 Báo cáo Bán hàng Đa kênh & Lợi nhuận gộp
        p.text-muted.fs-13.mb-0
          | Phạm vi thời gian: 
          span.badge.bg-primary-subtle.text-primary.fw-semibold #{range.periodLabel}
          |  (từ #{range.formattedStart} đến #{range.formattedEnd})
      .col-md-6.text-md-end.mt-3.mt-md-0
        .btn-group.me-2(role="group")
          a.btn.btn-sm(class=range.period === "today" ? "btn-primary" : "btn-outline-secondary", href=`/${pathAdmin}/dashboard/analytics?period=today`) Hôm nay
          a.btn.btn-sm(class=range.period === "yesterday" ? "btn-primary" : "btn-outline-secondary", href=`/${pathAdmin}/dashboard/analytics?period=yesterday`) Hôm qua
          a.btn.btn-sm(class=range.period === "7days" ? "btn-primary" : "btn-outline-secondary", href=`/${pathAdmin}/dashboard/analytics?period=7days`) 7 ngày
          a.btn.btn-sm(class=range.period === "30days" ? "btn-primary" : "btn-outline-secondary", href=`/${pathAdmin}/dashboard/analytics?period=30days`) 30 ngày
          a.btn.btn-sm(class=range.period === "thisMonth" ? "btn-primary" : "btn-outline-secondary", href=`/${pathAdmin}/dashboard/analytics?period=thisMonth`) Tháng này
          a.btn.btn-sm(class=range.period === "lastMonth" ? "btn-primary" : "btn-outline-secondary", href=`/${pathAdmin}/dashboard/analytics?period=lastMonth`) Tháng trước
        button.btn.btn-sm.btn-outline-primary(
          type="button" 
          data-bs-toggle="collapse" 
          data-bs-target="#customDateFilter" 
          aria-expanded="false"
        )
          i.las.la-calendar.me-1
          | Tùy chọn ngày

    // Form Tùy Chọn Ngày (Collapsible)
    #customDateFilter.collapse.mb-4(class=range.period === "custom" ? "show" : "")
      .card.border.shadow-none.bg-light-subtle
        .card-body.py-3
          form(action=`/${pathAdmin}/dashboard/analytics`, method="GET")
            input(type="hidden", name="period", value="custom")
            .row.g-3.align-items-end
              .col-sm-4.col-md-3
                label.form-label.fs-12.mb-1 Từ ngày:
                input.form-control.form-control-sm(
                  type="date" 
                  name="startDate" 
                  value=range.startDate ? range.startDate.toISOString().slice(0, 10) : ""
                  required
                )
              .col-sm-4.col-md-3
                label.form-label.fs-12.mb-1 Đến ngày:
                input.form-control.form-control-sm(
                  type="date" 
                  name="endDate" 
                  value=range.endDate ? range.endDate.toISOString().slice(0, 10) : ""
                  required
                )
              .col-sm-4.col-md-2
                button.btn.btn-sm.btn-primary.w-100(type="submit")
                  i.las.la-filter.me-1
                  | Lọc dữ liệu

    // Row 1: 4 Thẻ KPI Tài Chính Cốt Lõi
    .row.g-3.mb-4
      // KPI 1: Doanh Thu Thuần
      .col-sm-6.col-xl-3
        .card.h-100.border.shadow-none
          .card-body
            .d-flex.align-items-center.justify-content-between.mb-2
              span.text-muted.fs-13.fw-medium Tổng Doanh Thu Thuần
              span.avatar-xs.bg-primary-subtle.rounded-circle.d-flex.align-items-center.justify-content-center
                i.las.la-wallet.text-primary.fs-18
            h3.fs-22.fw-bold.text-primary.mb-1 #{kpis.netRevenue.toLocaleString("vi-VN")} đ
            .d-flex.align-items-center.justify-content-between.text-muted.fs-12
              span #{kpis.completedOrders} đơn hoàn tất
              span AOV: #{kpis.avgOrderValue.toLocaleString("vi-VN")} đ

      // KPI 2: Lợi Nhuận Gộp
      .col-sm-6.col-xl-3
        .card.h-100.border.shadow-none
          .card-body
            .d-flex.align-items-center.justify-content-between.mb-2
              span.text-muted.fs-13.fw-medium Lợi Nhuận Gộp (Gross Profit)
              span.avatar-xs.bg-success-subtle.rounded-circle.d-flex.align-items-center.justify-content-center
                i.las.la-chart-line.text-success.fs-18
            if canViewCost
              h3.fs-22.fw-bold.text-success.mb-1 #{kpis.grossProfit.toLocaleString("vi-VN")} đ
              .d-flex.align-items-center.justify-content-between.fs-12
                span.badge.bg-success-subtle.text-success Biên LN: +#{kpis.grossProfitMargin}%
                span.text-muted Giá vốn: #{kpis.cogs.toLocaleString("vi-VN")} đ
            else
              h3.fs-20.fw-bold.text-secondary.mb-1 ****** đ
              p.text-muted.fs-12.mb-0 Chỉ tài khoản có quyền xem giá vốn

      // KPI 3: Quầy Bán Lẻ POS
      .col-sm-6.col-xl-3
        .card.h-100.border.shadow-none
          .card-body
            .d-flex.align-items-center.justify-content-between.mb-2
              span.text-muted.fs-13.fw-medium Kênh Quầy POS
              span.avatar-xs.bg-info-subtle.rounded-circle.d-flex.align-items-center.justify-content-center
                i.las.la-cash-register.text-info.fs-18
            h3.fs-22.fw-bold.text-info.mb-1 #{kpis.posRevenue.toLocaleString("vi-VN")} đ
            .d-flex.align-items-center.justify-content-between.fs-12
              span.badge.bg-info-subtle.text-info Chiếm #{kpis.posShare}%
              span.text-muted #{kpis.posOrders} hóa đơn tại quầy

      // KPI 4: Kênh Website Online
      .col-sm-6.col-xl-3
        .card.h-100.border.shadow-none
          .card-body
            .d-flex.align-items-center.justify-content-between.mb-2
              span.text-muted.fs-13.fw-medium Kênh Website Online
              span.avatar-xs.bg-warning-subtle.rounded-circle.d-flex.align-items-center.justify-content-center
                i.las.la-globe.text-warning.fs-18
            h3.fs-22.fw-bold.text-warning.mb-1 #{kpis.onlineRevenue.toLocaleString("vi-VN")} đ
            .d-flex.align-items-center.justify-content-between.fs-12
              span.badge.bg-warning-subtle.text-warning Chiếm #{kpis.onlineShare}%
              span.text-muted #{kpis.onlineOrders} đơn đặt trực tuyến

    // Row 2: 3 Thẻ Vận Hành & Tài Sản Tồn Kho
    .row.g-3.mb-4
      // Thẻ Vốn Kho
      .col-md-4
        .card.h-100.border.shadow-none
          .card-body
            .d-flex.align-items-center.justify-content-between.mb-2
              span.text-muted.fs-13.fw-medium Định Giá Vốn Kho Sẵn Sàng Bán
              span.avatar-xs.bg-purple-subtle.rounded-circle.d-flex.align-items-center.justify-content-center
                i.las.la-warehouse.text-purple.fs-18
            if canViewCost
              h4.fs-20.fw-bold.text-dark.mb-1 #{kpis.availableStockCost.toLocaleString("vi-VN")} đ
              .d-flex.align-items-center.gap-2.text-muted.fs-12
                span.badge.bg-light.text-dark #{kpis.imeiStockQty} máy IMEI
                span.badge.bg-light.text-dark #{kpis.quantityStockQty} phụ kiện/hàng sl
            else
              h4.fs-20.fw-bold.text-secondary.mb-1 #{kpis.availableStockQty} sản phẩm
              p.text-muted.fs-12.mb-0 Đang có sẵn trong kho lưu trữ

      // Thẻ Dịch Vụ Bảo Hành & Sửa Chữa
      .col-md-4
        .card.h-100.border.shadow-none
          .card-body
            .d-flex.align-items-center.justify-content-between.mb-2
              span.text-muted.fs-13.fw-medium Doanh Thu Bảo Hành & Sửa Chữa
              span.avatar-xs.bg-danger-subtle.rounded-circle.d-flex.align-items-center.justify-content-center
                i.las.la-tools.text-danger.fs-18
            h4.fs-20.fw-bold.text-dark.mb-1 #{kpis.warrantyRevenue.toLocaleString("vi-VN")} đ
            .d-flex.align-items-center.justify-content-between.text-muted.fs-12
              span #{kpis.warrantyTotalTickets} phiếu tiếp nhận
              span.badge.bg-success-subtle.text-success #{warrantyBreakdown.statusCounts.completed + warrantyBreakdown.statusCounts.returned} phiếu đã xử lý

      // Thẻ Hồ Sơ Trả Góp
      .col-md-4
        .card.h-100.border.shadow-none
          .card-body
            .d-flex.align-items-center.justify-content-between.mb-2
              span.text-muted.fs-13.fw-medium Hồ Sơ Trả Góp Chờ Giải Ngân
              span.avatar-xs.bg-info-subtle.rounded-circle.d-flex.align-items-center.justify-content-center
                i.las.la-file-invoice-dollar.text-info.fs-18
            h4.fs-20.fw-bold.text-dark.mb-1 #{kpis.installmentPendingAmount.toLocaleString("vi-VN")} đ
            .d-flex.align-items-center.justify-content-between.text-muted.fs-12
              span #{kpis.installmentPendingCount} hồ sơ đang chờ đối tác
              span.text-primary.fw-medium Đối tác: HomeCredit, Mirae, HD

    // Row 3: Biểu Đồ Doanh Thu Theo Kênh & Cơ Cấu Kênh
    .row.g-3.mb-4
      // Biểu đồ xu hướng Timeline (POS vs Online)
      .col-lg-8
        .card.h-100.border.shadow-none
          .card-header.bg-transparent.border-bottom.py-3
            .d-flex.align-items-center.justify-content-between
              h5.card-title.mb-0 Xu hướng Doanh thu theo Kênh bán hàng (#{chartData.isHourly ? "Từng giờ" : "Từng ngày"})
              span.fs-12.text-muted
                span.badge.bg-info.me-1 &nbsp;
                | Quầy POS &nbsp;&nbsp;
                span.badge.bg-warning.me-1 &nbsp;
                | Online Web
          .card-body
            div(style="position: relative; height: 320px;")
              canvas#salesTimelineChart

      // Biểu đồ tỷ trọng kênh bán hàng
      .col-lg-4
        .card.h-100.border.shadow-none
          .card-header.bg-transparent.border-bottom.py-3
            h5.card-title.mb-0 Cơ cấu Kênh Bán Hàng
          .card-body.d-flex.flex-column.align-items-center.justify-content-center
            div(style="position: relative; height: 240px; width: 100%;")
              canvas#channelShareChart
            .d-flex.justify-content-around.w-100.mt-3.pt-2.border-top
              .text-center
                span.fs-12.text-muted POS Tại Quầy
                h6.mb-0.text-info #{kpis.posShare}% (#{kpis.posOrders} đơn)
              .text-center
                span.fs-12.text-muted Website Online
                h6.mb-0.text-warning #{kpis.onlineShare}% (#{kpis.onlineOrders} đơn)

    // Row 4: Phương Thức Thanh Toán & Tồn Kho
    .row.g-3.mb-4
      // Biểu đồ phương thức thanh toán
      .col-lg-6
        .card.h-100.border.shadow-none
          .card-header.bg-transparent.border-bottom.py-3
            h5.card-title.mb-0 Phương Thức Thanh Toán
          .card-body
            .row.align-items-center
              .col-sm-6
                div(style="position: relative; height: 230px;")
                  canvas#paymentMethodsChart
              .col-sm-6
                .table-responsive
                  table.table.table-sm.table-borderless.mb-0
                    tbody
                      each pm in paymentBreakdown
                        tr
                          td.py-1
                            span.fw-medium #{pm.label}
                          td.py-1.text-center
                            span.badge.bg-light.text-dark #{pm.count} đơn
                          td.py-1.text-end.fw-semibold #{pm.revenue.toLocaleString("vi-VN")} đ

      // Biểu đồ trạng thái tài sản tồn kho
      .col-lg-6
        .card.h-100.border.shadow-none
          .card-header.bg-transparent.border-bottom.py-3
            .d-flex.align-items-center.justify-content-between
              h5.card-title.mb-0 Cơ Cấu Trạng Thái Hàng Tồn Kho
              span.badge.bg-primary-subtle.text-primary Tổng: #{kpis.availableStockQty + inventoryBreakdown.sold.qty + inventoryBreakdown.warranty.qty + inventoryBreakdown.damaged.qty} đơn vị
          .card-body
            div(style="position: relative; height: 230px;")
              canvas#inventoryStatusChart

    // Row 5: Top Sản Phẩm Bán Chạy & Thống Kê Tiếp Nhận Bảo Hành
    .row.g-3.mb-4
      // Top 5 sản phẩm
      .col-lg-7
        .card.h-100.border.shadow-none
          .card-header.bg-transparent.border-bottom.py-3
            h5.card-title.mb-0 Top 5 Sản Phẩm Bán Chạy & Đóng Góp Lợi Nhuận
          .card-body.p-0
            .table-responsive
              table.table.table-hover.align-middle.mb-0
                thead.table-light
                  tr
                    th.ps-3 STT
                    th Sản phẩm & SKU
                    th.text-center Số lượng
                    th.text-end Doanh thu
                    if canViewCost
                      th.text-end Lợi nhuận gộp
                      th.text-center Biên LN
                tbody
                  if (topProducts && topProducts.length > 0)
                    each prod, idx in topProducts
                      tr
                        td.ps-3.fw-bold.text-muted #{idx + 1}
                        td
                          div.fw-semibold.text-dark #{prod.name}
                          small.text-muted SKU: #{prod.sku}
                        td.text-center
                          span.badge.bg-light.text-dark #{prod.quantity}
                        td.text-end.fw-semibold #{prod.revenue.toLocaleString("vi-VN")} đ
                        if canViewCost
                          td.text-end.text-success.fw-semibold #{prod.grossProfit.toLocaleString("vi-VN")} đ
                          td.text-center
                            span.badge.bg-success-subtle.text-success +#{prod.margin}%
                  else
                    tr
                      td.text-center.py-4(colspan=canViewCost ? "6" : "4")
                        span.text-muted Chưa có giao dịch nào trong khoảng thời gian đã chọn

      // Tiến độ tiếp nhận và sửa chữa bảo hành
      .col-lg-5
        .card.h-100.border.shadow-none
          .card-header.bg-transparent.border-bottom.py-3
            .d-flex.align-items-center.justify-content-between
              h5.card-title.mb-0 Tiến Độ Dịch Vụ Bảo Hành & Sửa Chữa
              span.badge.bg-info-subtle.text-info #{warrantyBreakdown.totalTickets} phiếu
          .card-body
            .mb-3
              .d-flex.justify-content-between.fs-13.mb-1
                span Mới tiếp nhận máy
                span.fw-semibold #{warrantyBreakdown.statusCounts.received} phiếu
              .progress(style="height: 6px;")
                .progress-bar.bg-secondary(style=`width: ${warrantyBreakdown.totalTickets > 0 ? (warrantyBreakdown.statusCounts.received / warrantyBreakdown.totalTickets * 100) : 0}%;`)
            .mb-3
              .d-flex.justify-content-between.fs-13.mb-1
                span Đang kiểm tra / Chờ linh kiện
                span.fw-semibold #{warrantyBreakdown.statusCounts.inspecting + warrantyBreakdown.statusCounts.waiting_parts} phiếu
              .progress(style="height: 6px;")
                .progress-bar.bg-warning(style=`width: ${warrantyBreakdown.totalTickets > 0 ? ((warrantyBreakdown.statusCounts.inspecting + warrantyBreakdown.statusCounts.waiting_parts) / warrantyBreakdown.totalTickets * 100) : 0}%;`)
            .mb-3
              .d-flex.justify-content-between.fs-13.mb-1
                span Đã hoàn tất sửa chữa
                span.fw-semibold #{warrantyBreakdown.statusCounts.completed} phiếu
              .progress(style="height: 6px;")
                .progress-bar.bg-primary(style=`width: ${warrantyBreakdown.totalTickets > 0 ? (warrantyBreakdown.statusCounts.completed / warrantyBreakdown.totalTickets * 100) : 0}%;`)
            .mb-3
              .d-flex.justify-content-between.fs-13.mb-1
                span Đã bàn giao lại cho khách
                span.fw-semibold.text-success #{warrantyBreakdown.statusCounts.returned} phiếu
              .progress(style="height: 6px;")
                .progress-bar.bg-success(style=`width: ${warrantyBreakdown.totalTickets > 0 ? (warrantyBreakdown.statusCounts.returned / warrantyBreakdown.totalTickets * 100) : 0}%;`)
            
            .p-3.bg-light.rounded.mt-4
              .d-flex.justify-content-between.align-items-center.mb-1
                span.fs-12.text-muted Tiền công dịch vụ:
                span.fs-13.fw-semibold #{warrantyBreakdown.repairFeeRevenue.toLocaleString("vi-VN")} đ
              .d-flex.justify-content-between.align-items-center
                span.fs-12.text-muted Doanh thu linh kiện thay thế:
                span.fs-13.fw-semibold #{warrantyBreakdown.partsRevenue.toLocaleString("vi-VN")} đ

block script
  script(src="https://cdn.jsdelivr.net/npm/chart.js")
  script.
    // Dữ liệu từ Controller
    const timelineLabels = !{chartData.timelineLabels};
    const posTimeline = !{chartData.posTimeline};
    const onlineTimeline = !{chartData.onlineTimeline};
    const channelLabels = !{chartData.channelLabels};
    const channelRevenue = !{chartData.channelRevenue};
    const paymentLabels = !{chartData.paymentLabels};
    const paymentRevenue = !{chartData.paymentRevenue};
    const inventoryLabels = !{chartData.inventoryStatusLabels};
    const inventoryCounts = !{chartData.inventoryStatusCounts};

    // Format tiền VND trong tooltip Chart.js
    const formatCurrency = (val) => Number(val || 0).toLocaleString('vi-VN') + ' đ';

    // 1. Biểu đồ Timeline Doanh thu Kênh POS vs Online
    const ctxTimeline = document.getElementById('salesTimelineChart');
    if (ctxTimeline) {
      new Chart(ctxTimeline, {
        type: 'bar',
        data: {
          labels: timelineLabels,
          datasets: [
            {
              label: 'Quầy POS',
              data: posTimeline,
              backgroundColor: 'rgba(13, 202, 240, 0.75)',
              borderColor: 'rgba(13, 202, 240, 1)',
              borderWidth: 1,
              borderRadius: 4
            },
            {
              label: 'Online Store',
              data: onlineTimeline,
              backgroundColor: 'rgba(255, 193, 7, 0.75)',
              borderColor: 'rgba(255, 193, 7, 1)',
              borderWidth: 1,
              borderRadius: 4
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'top' },
            tooltip: {
              callbacks: {
                label: function(context) {
                  return context.dataset.label + ': ' + formatCurrency(context.raw);
                }
              }
            }
          },
          scales: {
            x: { stacked: true, grid: { display: false } },
            y: {
              stacked: true,
              ticks: {
                callback: function(value) {
                  if (value >= 1000000) return (value / 1000000).toFixed(0) + ' Tr';
                  if (value >= 1000) return (value / 1000).toFixed(0) + ' K';
                  return value;
                }
              }
            }
          }
        }
      });
    }

    // 2. Biểu đồ Donut Tỷ trọng Kênh bán hàng
    const ctxChannel = document.getElementById('channelShareChart');
    if (ctxChannel) {
      new Chart(ctxChannel, {
        type: 'doughnut',
        data: {
          labels: channelLabels,
          datasets: [{
            data: channelRevenue,
            backgroundColor: [
              'rgba(13, 202, 240, 0.85)',
              'rgba(255, 193, 7, 0.85)'
            ],
            borderWidth: 2,
            hoverOffset: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom' },
            tooltip: {
              callbacks: {
                label: function(context) {
                  return context.label + ': ' + formatCurrency(context.raw);
                }
              }
            }
          },
          cutout: '70%'
        }
      });
    }

    // 3. Biểu đồ Phương thức thanh toán
    const ctxPayment = document.getElementById('paymentMethodsChart');
    if (ctxPayment) {
      new Chart(ctxPayment, {
        type: 'pie',
        data: {
          labels: paymentLabels,
          datasets: [{
            data: paymentRevenue,
            backgroundColor: [
              'rgba(40, 167, 69, 0.85)',
              'rgba(0, 123, 255, 0.85)',
              'rgba(23, 162, 184, 0.85)',
              'rgba(220, 53, 69, 0.85)',
              'rgba(108, 117, 125, 0.85)',
              'rgba(255, 193, 7, 0.85)'
            ],
            borderWidth: 1
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: function(context) {
                  return context.label + ': ' + formatCurrency(context.raw);
                }
              }
            }
          }
        }
      });
    }

    // 4. Biểu đồ Trạng thái tồn kho thiết bị
    const ctxInventory = document.getElementById('inventoryStatusChart');
    if (ctxInventory) {
      new Chart(ctxInventory, {
        type: 'bar',
        data: {
          labels: inventoryLabels,
          datasets: [{
            label: 'Số lượng thiết bị / đơn vị',
            data: inventoryCounts,
            backgroundColor: [
              'rgba(40, 167, 69, 0.75)',
              'rgba(0, 123, 255, 0.75)',
              'rgba(255, 193, 7, 0.75)',
              'rgba(220, 53, 69, 0.75)',
              'rgba(108, 117, 125, 0.75)'
            ],
            borderRadius: 4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          scales: {
            x: { grid: { display: false } },
            y: {
              ticks: { precision: 0 }
            }
          }
        }
      });
    }
