extends ../layouts/default.pug

block main
  .row
    .col-12
      // 3 Thẻ Thống Kê Nhanh
      .row.g-3.mb-3
        .col-md-4
          .card.mb-0
            .card-body.p-3
              .d-flex.align-items-center
                .avatar-sm.bg-info-subtle.rounded-circle.me-3.d-flex.align-items-center.justify-content-center
                  i.las.la-store-alt.fs-3.text-info
                div
                  h6.text-muted.mb-1 Đại lý đang hoạt động
                  h4.mb-0 #{stats.wholesaleCustomerCount} đại lý
        .col-md-4
          .card.mb-0
            .card-body.p-3
              .d-flex.align-items-center
                .avatar-sm.bg-primary-subtle.rounded-circle.me-3.d-flex.align-items-center.justify-content-center
                  i.las.la-boxes.fs-3.text-primary
                div
                  h6.text-muted.mb-1 Tổng đơn hàng sỉ
                  h4.mb-0 #{stats.wholesaleOrderCount} đơn
        .col-md-4
          .card.mb-0
            .card-body.p-3
              .d-flex.align-items-center
                .avatar-sm.bg-success-subtle.rounded-circle.me-3.d-flex.align-items-center.justify-content-center
                  i.las.la-coins.fs-3.text-success
                div
                  h6.text-muted.mb-1 Doanh thu kênh sỉ
                  h4.mb-0.text-success #{stats.wholesaleRevenue.toLocaleString("vi-VN")} đ

      .card
        .card-header
          .row.align-items-center
            .col
              h4.card-title.mb-0 #{pageTitle}
            .col-auto
              a.btn.btn-secondary(href=`/${pathAdmin}/wholesale/list`)
                i.las.la-arrow-left.me-1
                | Danh sách đại lý

        .card-body
          form#wholesaleSettingsForm
            .row.g-4
              .col-lg-8
                .p-3.border.rounded.bg-light-subtle.mb-3
                  .form-check.form-switch
                    input#enabledSwitch.form-check-input(
                      type="checkbox"
                      name="enabled"
                      checked=policy.enabled
                    )
                    label.form-check-label.fw-bold(for="enabledSwitch")
                      | Bật ràng buộc đơn hàng bán sỉ (B2B)
                  small.text-muted.d-block.mt-1
                    | Bắt buộc đại lý đạt số lượng máy hoặc giá trị tối thiểu để đặt hàng theo bảng giá sỉ.

                .row.g-3
                  .col-md-6
                    label.form-label.fw-semibold(for="minQuantity") Số lượng máy tối thiểu *
                    .input-group
                      input#minQuantity.form-control(
                        type="number"
                        name="minQuantity"
                        min="1"
                        value=policy.minQuantity
                        required
                      )
                      span.input-group-text máy

                  .col-md-6
                    label.form-label.fw-semibold(for="minOrderTotal") Tổng giá trị đơn tối thiểu *
                    .input-group
                      input#minOrderTotal.form-control(
                        type="number"
                        name="minOrderTotal"
                        min="0"
                        step="500000"
                        value=policy.minOrderTotal
                        required
                      )
                      span.input-group-text đ

                  .col-md-12
                    label.form-label.fw-semibold(for="conditionMode") Điều kiện áp dụng
                    select#conditionMode.form-select(name="conditionMode")
                      option(value="or" selected=policy.conditionMode === "or")
                        | Thỏa 1 trong 2: Đủ số lượng máy HOẶC Đủ tổng tiền đơn
                      option(value="and" selected=policy.conditionMode === "and")
                        | Bắt buộc cả 2: Đủ số lượng máy VÀ Đủ tổng tiền đơn

                  .col-md-12
                    .card.border.shadow-none.mb-0
                      .card-body.p-3
                        .form-check.form-switch.mb-2
                          input#countOnlyImei.form-check-input(
                            type="checkbox"
                            name="countOnlyImei"
                            checked=policy.countOnlyImei
                          )
                          label.form-check-label.fw-semibold(for="countOnlyImei")
                            | Chỉ tính thiết bị có mã IMEI vào điều kiện số lượng máy
                          div.text-muted.fs-12 Phụ kiện thường (ốp lưng, cáp sạc) sẽ tính theo tổng tiền đơn hàng.

                        .form-check.form-switch
                          input#allowPosOverride.form-check-input(
                            type="checkbox"
                            name="allowPosOverride"
                            checked=policy.allowPosOverride
                          )
                          label.form-check-label.fw-semibold(for="allowPosOverride")
                            | Cho phép thu ngân POS xuất giá sỉ ngoại lệ tại quầy
                          div.text-muted.fs-12 Thu ngân có thể xác nhận bán giá sỉ tại quầy khi đơn đạt ràng buộc.

                  .col-md-12
                    label.form-label.fw-semibold(for="policyNote") Ghi chú chính sách
                    textarea#policyNote.form-control(name="policyNote" rows="2") #{policy.policyNote}

              .col-lg-4
                .card.border.shadow-none.bg-light-subtle.h-100
                  .card-body
                    h6.card-title.text-primary.mb-3
                      i.las.la-info-circle.me-1
                      | Quy tắc đang kích hoạt
                    .p-2.bg-white.rounded.border.mb-3
                      #liveRulePreview.fs-13.fw-semibold.text-dark

            .mt-4.pt-3.border-top
              if (permissions.includes("wholesale-setting"))
                button.btn.btn-primary(type="submit")
                  | Lưu chính sách
              a.btn.btn-danger.ms-2(href=`/${pathAdmin}/wholesale/list`) Hủy

block script
  script.
    const notyf = new Notyf({ duration: 3000, position: { x: 'right', y: 'top' } });

    const minQtyInput = document.getElementById('minQuantity');
    const minTotalInput = document.getElementById('minOrderTotal');
    const modeSelect = document.getElementById('conditionMode');
    const imeiSwitch = document.getElementById('countOnlyImei');
    const enabledSwitch = document.getElementById('enabledSwitch');
    const previewBox = document.getElementById('liveRulePreview');

    function updatePreview() {
      if (!previewBox) return;
      if (!enabledSwitch.checked) {
        previewBox.innerHTML = '<span class="text-warning">Không giới hạn: Đại lý có thể mua số lượng bất kỳ với giá sỉ.</span>';
        return;
      }
      const qty = Number(minQtyInput.value || 3);
      const total = Number(minTotalInput.value || 20000000).toLocaleString('vi-VN');
      const modeText = modeSelect.value === 'and' ? '<span class="text-danger">VÀ</span>' : '<span class="text-primary">HOẶC</span>';
      const unitText = imeiSwitch.checked ? 'thiết bị (IMEI)' : 'sản phẩm';
      previewBox.innerHTML = `Từ <b>${qty} ${unitText}</b> ${modeText} Tổng đơn từ <b>${total} đ</b>.`;
    }

    [minQtyInput, minTotalInput, modeSelect, imeiSwitch, enabledSwitch].forEach(el => {
      if (el) el.addEventListener('input', updatePreview);
      if (el) el.addEventListener('change', updatePreview);
    });
    updatePreview();

    const settingsForm = document.getElementById('wholesaleSettingsForm');
    if (settingsForm) {
      settingsForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
          enabled: enabledSwitch.checked,
          minQuantity: Number(minQtyInput.value),
          minOrderTotal: Number(minTotalInput.value),
          conditionMode: modeSelect.value,
          countOnlyImei: imeiSwitch.checked,
          allowPosOverride: document.getElementById('allowPosOverride').checked,
          policyNote: document.getElementById('policyNote').value
        };

        try {
          const res = await fetch(`/${pathAdmin}/wholesale/settings`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const data = await res.json();
          if (data.code === 'success') {
            notyf.success(data.message);
          } else {
            notyf.error(data.message || 'Không thể lưu cấu hình!');
          }
        } catch (err) {
          notyf.error('Lỗi kết nối máy chủ!');
        }
      });
    }
