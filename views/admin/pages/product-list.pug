extends ../layouts/default.pug
include ../mixins/pagination.pug
include ../mixins/form-search.pug

block main
  .row
    .col-12
      .card
        .card-header
          .row.align-items-center
            .col
              h4.card-title #{pageTitle}
            // end col
            .col-auto
              a.btn.btn-primary(
                href=`/${pathAdmin}/product/create`
                )
                i.fa-solid.fa-plus.me-1
                | Tạo sản phẩm
                // end col
            // end col
          // end row
        // end card-header
        .card-body.pt-0
          .row
            .col-sm-6
              +form-search()
            .col-sm-3
              a.btn.w-100.btn-info(href=`/${pathAdmin}/product/export/csv`)
                i.fa-solid.fa-download.me-1
                | Xuất Excel
            .col-lg-4
              form.input-group.mb-3(
                id="formImportExcel"
                data-api=`/${pathAdmin}/product/import/csv`
              )
                input(
                  class="form-control" 
                  type="file" 
                  name="file" 
                  id="file"
                  accept=".csv"
                )
                button.btn.btn-secondary Nhúng Excel
          .table-responsive
            table.table.table-striped.mb-0
              thead.table-light
                tr
                  th STT
                  th Avatar
                  th Tên sản phẩm
                  th Giá kênh sỉ
                  th Giá kênh lẻ (cũ)
                  th Giá kênh lẻ (mới)
                  th Còn lại
                  th Số biến thể
                  th Vị trí
                  th Trạng thái
                  th Lượt xem
                  th.text-end.text-nowrap(style="min-width: 110px; width: 110px;") Hành động
              tbody
                each item, index in recordList
                  tr
                    td #{pagination.skip + index + 1}
                    td
                      if(item.images && item.images.length > 0)
                        img(
                          src=`${domainCDN}${item.images[0]}`
                          class="rounded thumb-md me-1 d-inline"
                        )
                    td #{item.name}
                    td
                      if(item.priceWholeSale)
                        | #{item.priceWholeSale.toLocaleString("vi-VN")}
                    td
                      if(item.priceOld)
                        | #{item.priceOld.toLocaleString("vi-VN")}
                    td
                      if(item.priceNew)
                        | #{item.priceNew.toLocaleString("vi-VN")}
                    td #{item.stock}
                    td #{item.variants.filter(v => v.status == true).length}
                    td #{item.position}
                    td
                      if (item.status == "draft")
                        span(class="badge bg-dark") Bản nháp
                      else if (item.status == "active")
                        span(class="badge bg-success") Hoạt động
                      else if (item.status == "inactive")
                        span(class="badge bg-danger") Tạm dừng
                    td #{item.view}
                    td.text-end.text-nowrap(style="min-width: 110px;")
                      a.me-1(href=`/${pathAdmin}/product/edit/${item.id}` title="Chỉnh sửa")
                        i.las.la-pen.text-info.fs-20
                      a.me-1(
                        href=`/${pathAdmin}/product/edit-seo/${item.id}`
                        title="Chỉnh sửa SEO"
                        )
                        i.las.la-edit.text-warning.fs-20
                      a(
                        href="javascript:;"
                        button-api
                        data-method="PATCH"
                        data-api=`/${pathAdmin}/product/delete/${item.id}`
                        title="Xóa"
                      )
                        i.las.la-trash-alt.text-danger.fs-20
          +pagination()
    // end col